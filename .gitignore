# Dependencias
node_modules/

# Salida de build (se regenera con `npm run build`)
dist/
.astro/

# Entorno
.env
.env.*
!.env.example

# Sistema
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-error.log*

# Configuración de despliegue (contiene host y usuario del VPS)
.env.deploy

# Estado local de la CLI de Netlify (site_id de esta máquina, no del proyecto)
.netlify/

# Artefactos de deploy (identificadores de Netlify, no fuente)
deploy_id.txt
deploy_info.json

# Salida de build del adaptador de Vercel
.vercel/
