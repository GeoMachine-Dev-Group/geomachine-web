---
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const labels: Record<Lang, { button: string; whatsapp: string; telegram: string; tooltip: string }> = {
  es: {
    button: 'Chat directo',
    whatsapp: 'WhatsApp directo',
    telegram: 'Telegram directo',
    tooltip: 'Habla directo con el desarrollador',
  },
  ru: {
    button: 'Прямой чат',
    whatsapp: 'WhatsApp напрямую',
    telegram: 'Telegram напрямую',
    tooltip: 'Чат напрямую с разработчиком',
  },
  en: {
    button: 'Direct Chat',
    whatsapp: 'Direct WhatsApp',
    telegram: 'Direct Telegram',
    tooltip: 'Talk directly with the developer',
  },
  ka: {
    button: 'პირდაპირი ჩატი',
    whatsapp: 'პირდაპირი WhatsApp',
    telegram: 'პირდაპირი Telegram',
    tooltip: 'ესაუბრეთ პირდაპირ დეველოპერს',
  },
};

const t = labels[lang];
---

<div class="floating-chat" id="floating-chat-container">
  <div class="floating-chat__menu" id="floating-chat-menu">
    <a
      href="https://t.me/geomachine"
      target="_blank"
      rel="noopener noreferrer"
      class="floating-chat__item floating-chat__item--tg"
      aria-label={t.telegram}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
      <span>{t.telegram}</span>
    </a>
    <a
      href="https://wa.me/34600000000?text=Hola,%20busco%20presupuesto%20para%20un%20proyecto"
      target="_blank"
      rel="noopener noreferrer"
      class="floating-chat__item floating-chat__item--wa"
      aria-label={t.whatsapp}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      <span>{t.whatsapp}</span>
    </a>
  </div>

  <button type="button" class="floating-chat__trigger" id="floating-chat-toggle" aria-label={t.button}>
    <span class="floating-chat__badge" aria-hidden="true"></span>
    <svg class="icon-chat" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="floating-chat__label">{t.button}</span>
  </button>
</div>

<script is:inline>
  (function() {
    var toggleBtn = document.getElementById('floating-chat-toggle');
    var menu = document.getElementById('floating-chat-menu');

    if (toggleBtn && menu) {
      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        menu.classList.toggle('is-open');
      });

      document.addEventListener('click', function(e) {
        if (!menu.contains(e.target) && !toggleBtn.contains(e.target)) {
          menu.classList.remove('is-open');
        }
      });
    }
  })();
</script>
