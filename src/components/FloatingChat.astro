---
/**
 * Botón flotante único de contacto: abre un menú con "Pedir presupuesto",
 * Telegram y WhatsApp. Sustituye a los dos botones que había (chat abajo a la
 * izquierda y presupuesto abajo a la derecha). El enlace de presupuesto va a
 * la sección de contacto del catálogo con ruta completa, para que funcione
 * también desde el blog, que no tiene #contacto propio.
 */
import { ui, servicesPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const labels: Record<Lang, { button: string; whatsappText: string }> = {
  es: { button: 'Contacto', whatsappText: 'Hola, busco presupuesto para un proyecto' },
  ru: { button: 'Связаться', whatsappText: 'Здравствуйте, хочу узнать стоимость проекта' },
  en: { button: 'Contact', whatsappText: "Hi, I'd like a quote for a project" },
  // ka: traducido por IA, pendiente de revisión nativa (ver aviso al inicio de ui.ts).
  ka: { button: 'კონტაქტი', whatsappText: 'გამარჯობა, მინდა პროექტის ფასი გავიგო' },
};
const l = labels[lang];
const whatsappHref = `https://wa.me/34620811739?text=${encodeURIComponent(l.whatsappText)}`;
---

<div class="contact-fab" data-contact-fab hidden>
  <div class="contact-fab__menu" id="contact-fab-menu" hidden>
    <a class="contact-fab__item contact-fab__item--quote" href={`${servicesPath[lang]}#contacto`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="8" y1="13" x2="16" y2="13"></line>
        <line x1="8" y1="17" x2="13" y2="17"></line>
      </svg>
      <span>{t.ctaButton}</span>
    </a>
    <a class="contact-fab__item" href="https://t.me/geomachine" target="_blank" rel="noopener noreferrer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
      <span>Telegram</span>
    </a>
    <a class="contact-fab__item" href={whatsappHref} target="_blank" rel="noopener noreferrer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>

  <button type="button" class="contact-fab__trigger" aria-expanded="false" aria-controls="contact-fab-menu">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span>{l.button}</span>
  </button>
</div>

<script>
  const fab = document.querySelector<HTMLElement>('[data-contact-fab]');
  const trigger = fab?.querySelector<HTMLButtonElement>('.contact-fab__trigger');
  const menu = fab?.querySelector<HTMLElement>('.contact-fab__menu');

  if (fab && trigger && menu) {
    fab.hidden = false;

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(menu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!fab.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    /* Visible al perder de vista la cabecera; oculto cerca de un CTA de cierre
       si la página declara data-fab-hide-near (el catálogo, en su sección de
       contacto). El blog no lo declara, así que ahí se queda visible. */
    const header = document.querySelector('.plate');
    const hideNear = document.querySelector('[data-fab-hide-near]');
    let pastHeader = !header;
    let nearHide = false;
    const sync = () => {
      const visible = pastHeader && !nearHide;
      fab.classList.toggle('is-visible', visible);
      if (!visible) setOpen(false);
    };

    if (header) {
      new IntersectionObserver(
        ([entry]) => { pastHeader = !entry.isIntersecting; sync(); },
        { rootMargin: '-10% 0px 0px 0px' }
      ).observe(header);
    }
    if (hideNear) {
      new IntersectionObserver(
        ([entry]) => { nearHide = entry.isIntersecting; sync(); },
        { threshold: 0.15 }
      ).observe(hideNear);
    }
    sync();
  }
</script>
