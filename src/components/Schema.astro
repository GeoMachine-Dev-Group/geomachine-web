---
/**
 * JSON-LD para el catálogo. Los precios reflejan la tarifa que se ve por
 * defecto en la página (DEFAULT_TIER / DEFAULT_CURRENCY): el structured data
 * debe coincidir con el contenido visible o Google lo penaliza.
 */
import {
  lines,
  bundles,
  DEFAULT_TIER,
  DEFAULT_CURRENCY,
  type Item,
  type Bundle,
  type Unit,
} from '../data/catalog';
import { ui, servicesPath, type Lang } from '../i18n/ui';
import { orgId as buildOrgId } from '../data/organization';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const site = Astro.site?.origin ?? 'https://geomachine.es';
const pageUrl = site + servicesPath[lang];
const orgId = buildOrgId(site);

const currencyCode: Record<string, string> = { eur: 'EUR', rub: 'RUB', gel: 'GEL' };
const cur = currencyCode[DEFAULT_CURRENCY] ?? 'EUR';

/** 'once' no lleva especificación; 'month' y 'hour' sí. */
function unitSpec(unit: Unit) {
  if (unit === 'month') return { referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' } };
  if (unit === 'hour') return { referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'HUR' } };
  return {};
}

/** Rango [min,max] -> AggregateOffer; valor único -> Offer. */
function priceOf(range: readonly number[], unit: Unit) {
  const spec = unitSpec(unit);
  const hasSpec = Object.keys(spec).length > 0;
  const base = {
    priceCurrency: cur,
    availability: 'https://schema.org/InStock',
    ...(hasSpec
      ? { priceSpecification: { '@type': 'UnitPriceSpecification', priceCurrency: cur, ...spec } }
      : {}),
  };
  if (range.length === 2) {
    return { '@type': 'AggregateOffer', lowPrice: range[0], highPrice: range[1], offerCount: 1, ...base };
  }
  return { '@type': 'Offer', price: range[0], ...base };
}

function offerForItem(item: Item, category: string) {
  return {
    '@type': 'Offer',
    '@id': `${pageUrl}#${item.code.toLowerCase()}`,
    name: item.name[lang],
    description: item.spec[lang],
    category,
    ...(item.time ? { deliveryLeadTime: { '@type': 'QuantitativeValue', description: item.time[lang] } } : {}),
    itemOffered: {
      '@type': 'Service',
      name: item.name[lang],
      description: item.spec[lang],
      serviceType: category,
      provider: { '@id': orgId },
    },
    ...priceOf(item[DEFAULT_TIER][DEFAULT_CURRENCY], item.unit),
  };
}

function offerForBundle(b: Bundle) {
  return {
    '@type': 'Offer',
    '@id': `${pageUrl}#${b.code.toLowerCase()}`,
    name: b.name[lang],
    description: b.includes[lang].join(' · '),
    category: t.bundlesTitle,
    itemOffered: {
      '@type': 'Service',
      name: b.name[lang],
      description: b.includes[lang].join(' · '),
      provider: { '@id': orgId },
    },
    ...priceOf(b[DEFAULT_TIER][DEFAULT_CURRENCY], 'once'),
  };
}

const catalogSections = [
  ...lines.map((line) => ({
    '@type': 'OfferCatalog',
    name: line.title[lang],
    description: line.note[lang],
    itemListElement: line.items.map((item) => offerForItem(item, line.title[lang])),
  })),
  {
    '@type': 'OfferCatalog',
    name: t.bundlesTitle,
    description: t.bundlesNote,
    itemListElement: bundles.map(offerForBundle),
  },
];

/** Mismas 3 preguntas que renderiza la sección .faq de Catalog.astro — si
    se añade o quita una ahí, hay que reflejarlo aquí también. */
const faqEntity = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: [
    { '@type': 'Question', name: t.faqQ1, acceptedAnswer: { '@type': 'Answer', text: t.faqA1 } },
    { '@type': 'Question', name: t.faqQ2, acceptedAnswer: { '@type': 'Answer', text: t.faqA2 } },
    {
      '@type': 'Question',
      name: t.faqQ3,
      acceptedAnswer: { '@type': 'Answer', text: `${t.faqA3Before}${t.faqMntLink}${t.faqA3After}` },
    },
  ],
};

// La organización (ProfessionalService, priceRange, makesOffer...) ya la
// emite Base.astro una vez por página vía buildOrganization() — este @graph
// solo añade lo específico de la página de servicios (WebPage + catálogo +
// FAQ) y referencia el @id central, nunca lo redeclara.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: t.metaTitle,
      description: t.metaDescription,
      inLanguage: t.htmlLang,
      isPartOf: { '@id': orgId },
      about: { '@id': orgId },
      mainEntity: { '@id': faqEntity['@id'] },
    },
    {
      '@type': 'OfferCatalog',
      '@id': `${pageUrl}#catalog`,
      name: t.plate,
      url: pageUrl,
      provider: { '@id': orgId },
      itemListElement: catalogSections,
    },
    faqEntity,
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
