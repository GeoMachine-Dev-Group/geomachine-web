    appleTouch: '/optimus/apple-touch-icon.png',
  }}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': `${pageUrl}#webpage`,
          url: pageUrl,
          name: t.title,
          description: t.description,
          inLanguage: lang,
          isPartOf: { '@id': orgId },
          about: { '@id': orgId },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': `${pageUrl}#app`,
          name: 'Optimus',
          operatingSystem: 'Android 7.0+',
          applicationCategory: 'TravelApplication',
          softwareVersion: manifest.version,
          fileSize: `${mb(manifest.bytes)} MB`,
          downloadUrl: APK,
          provider: { '@id': orgId },
        },
      ],
    })} />
  </Fragment>

  <section class="hero app-hero shell">
    <img class="optimus-logo" src="/optimus/logotipo-sobre-oscuro.svg" alt="Optimus" width="308" height="90" />
    <p class="hero__eyebrow">{t.tagline}</p>
    <h1 class="hero__title">{t.headline}</h1>
    <p class="hero__body">{t.lead}</p>

    <div class="app-hero__downloads">
      <a href={APK} download class="app-download app-download--primary" id="optimus-download">{downloadText}</a>
    </div>
    <p class="hero__note navcam-meta" id="optimus-meta">{metaText}</p>
    <p class="hero__note navcam-meta">
      {t.shaIntro} <a href={SHA_URL} rel="noopener">{SHA_URL.replace('https://', '')}</a>{t.shaOutro}
    </p>
  </section>

  <section class="shell app-section">
    <div class="app-panel">
      <div>
        <h2 class="app-panel__title app-panel__title--stamp">⚠️ {t.warnTitle}</h2>
        <ul class="app-panel__steps">
          {t.warn.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>

    <div class="app-panel" id="optimus-news" hidden={news.length === 0}>
      <div>
        <h2 class="app-panel__title">{t.newsTitle}</h2>
        <ul class="app-panel__steps" id="optimus-news-list">
          {news.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>

    <h2 class="app-section__title">{t.featuresTitle}</h2>
    <div class="app-features">
      {t.features.map(({ title, desc }) => (
        <div class="app-feature">
          <h3 class="app-feature__title">{title}</h3>
          <p class="app-feature__text">{desc}</p>
        </div>
      ))}
    </div>
    <p class="app-panel__text navcam-langs"><strong>{t.langsLabel}:</strong> {APP_LANGS}</p>

    <div class="app-panel">
      <div>
        <h2 class="app-panel__title">{t.installTitle}</h2>
        <ul class="app-panel__steps">
          {t.installSteps.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="app-panel__title">{t.startTitle}</h2>
        <ul class="app-panel__steps">
          {t.startText.map((s) => <li>{s}</li>)}
        </ul>
        <div class="app-hero__downloads">
          <a href={whatsappHref} class="app-download" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href={TELEGRAM} class="app-download" target="_blank" rel="noopener noreferrer">Telegram</a>
        </div>
      </div>
    </div>

    <div class="app-panel">
      <div>
        <h2 class="app-panel__title">{t.privacyTitle}</h2>
        <p class="app-panel__text">{t.privacyText}</p>
        <p class="app-panel__text"><a href={legalPath('privacy', lang)}>{t.privacyLink}</a></p>
      </div>

      <div>
        <h2 class="app-panel__title">{t.faqTitle}</h2>
        <ul class="app-panel__steps">
          {t.faq.map(({ q, a }) => <li><strong>{q}</strong> {a}</li>)}
        </ul>
      </div>
    </div>

    <div class="app-back">
      <a href="/">← {t.backToHome}</a>
      <a href={qrHref} class="navcam-qr" rel="nofollow">{t.qrLink}</a>
    </div>
  </section>
</Base>

<script
  define:vars={{
    lang,
    manifestUrl: MANIFEST_URL,
    tpl: { download: t.download, meta: t.meta },
  }}
>
  // El HTML del build ya trae los valores; esto solo los refresca si el
  // manifiesto publicado ahora es distinto. Si falla, no se toca nada.
  (async () => {
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 5000);
      const res = await fetch(manifestUrl, { signal: ctrl.signal, cache: 'no-cache' });
      clearTimeout(timer);
      if (!res.ok) return;
      const m = await res.json();
      if (!m || typeof m.version !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(m.fecha) || !(m.bytes > 0)) return;
      const locales = { es: 'es-ES', ru: 'ru-RU', en: 'en-GB', ka: 'ka-GE' };
      const fecha = new Intl.DateTimeFormat(locales[lang] || 'en-GB', {
        day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
      }).format(new Date(m.fecha + 'T12:00:00Z')).replace(/\.(?=\s|$)/g, '');
      const fill = (s) => s.replace('{mb}', String(Math.round(m.bytes / 1e6))).replace('{version}', m.version).replace('{fecha}', fecha);
      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el && el.textContent !== text) el.textContent = text;
      };
      setText('optimus-download', fill(tpl.download));
      setText('optimus-meta', fill(tpl.meta));
      if (typeof m.apk === 'string' && m.apk.startsWith('https://')) {
        const a = document.getElementById('optimus-download');
        if (a && a.getAttribute('href') !== m.apk) a.setAttribute('href', m.apk);
      }
      const nov = m.novedades || {};
      const lines = (Array.isArray(nov[lang]) && nov[lang].length ? nov[lang] : nov.en) || [];
      const box = document.getElementById('optimus-news');
      const list = document.getElementById('optimus-news-list');
      if (box && list && Array.isArray(lines)) {
        const current = Array.from(list.children).map((li) => li.textContent);
        if (JSON.stringify(current) !== JSON.stringify(lines)) {
          list.replaceChildren(...lines.map((l) => Object.assign(document.createElement('li'), { textContent: String(l) })));
        }
        box.hidden = lines.length === 0;
      }
    } catch (_) {
      // sin red o JSON roto: se queda lo que trajo el build
    }
  })();
</script>

<style>
  .app-panel[hidden] { display: none; }
  /* La O empieza a 22,3 de los 308,4 de ancho del SVG (7,2 %): se compensa para alinearla con el texto. */
  .optimus-logo { display: block; width: min(100%, 19rem); height: auto; margin: 0 0 var(--space-6) calc(-0.072 * min(100%, 19rem)); }
  .navcam-meta { margin-top: var(--space-4); }
  .navcam-hash { display: block; margin-top: var(--space-2); overflow-wrap: anywhere; font-family: var(--data); font-size: var(--fs-2xs); }
  .app-back { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: var(--space-6); }
  .app-back .navcam-qr { font-size: var(--fs-2xs); opacity: .75; }
  .navcam-langs { margin-bottom: var(--space-16); }
</style>
