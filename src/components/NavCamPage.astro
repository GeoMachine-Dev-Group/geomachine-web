const site = 'https://geomachine.es';

const hreflangAlternates = [
  { hreflang: 'x-default', href: `${site}/es/servicios/navcam-conductor/` },
  { hreflang: 'es', href: `${site}/es/servicios/navcam-conductor/` },
  { hreflang: 'en', href: `${site}/en/services/navcam-conductor/` },
  { hreflang: 'ru', href: `${site}/ru/uslugi/navcam-conductor/` },
  { hreflang: 'ka', href: `${site}/ka/momsakhurebebi/navcam-conductor/` },
