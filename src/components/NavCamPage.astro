const downloadText = fill(t.download, manifest);
const metaText = fill(t.meta, manifest);
const news = novedadesFor(manifest, lang);
const qrHref = '/optimus/qr/';
const site = 'https://geomachine.es';

const hreflangAlternates = [
  { hreflang: 'x-default', href: `${site}/es/servicios/optimus/` },
  { hreflang: 'es', href: `${site}/es/servicios/optimus/` },
  { hreflang: 'en', href: `${site}/en/services/optimus/` },
  { hreflang: 'ru', href: `${site}/ru/uslugi/optimus/` },
  { hreflang: 'ka', href: `${site}/ka/momsakhurebebi/optimus/` },
];
const pageUrl = hreflangAlternates.find((a) => a.hreflang === lang)!.href;
const orgId = buildOrgId(site);
const whatsappHref = `https://wa.me/34620811739?text=${encodeURIComponent(t.whatsappText)}`;
