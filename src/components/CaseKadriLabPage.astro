---
/**
 * Caso de cliente: kadrilab.com. Página propia en los cuatro idiomas, con el
 * mismo formato que AppAccountsPage.astro (hero, tarjetas, panel) y sus clases
 * `.app-*`. No va al blog: en georgiano no hay blog a propósito (ver ui.ts).
 *
 * Solo lleva lo que consta en el proyecto de KADRI LAB (AGENTS.md,
 * public/admin/config.yml y .github/workflows/cms-validate.yml de su repo) y lo
 * que dio el cliente. Nada de reseñas, cifras de audiencia, nombres del equipo
 * ni teléfonos: solo el enlace a kadrilab.com.
 *
 * ka: traducción automática, PENDIENTE DE REVISIÓN NATIVA (igual que el resto
 * del georgiano del sitio). statusTitle/statusPoints/statusNote en ka: ka sin revisar.
 *
 * «Dónde está hoy» (2026-11-01): fechas del repo geomachine1/kadrilab (primer
 * commit 23-sep, SEO de lanzamiento 28-sep, 68 commits), lo que se ve en
 * kadrilab.com (7 fotos de portfolio, 1 película publicada y 3 ocultas sin
 * vídeo, retratos del equipo con monograma) y los PR del panel (4, todos pruebas
 * de GeoMachine del 26-sep, cerrados). Si el estudio empieza a subir fotos,
 * actualizar.
 */
import Base from '../layouts/Base.astro';
import { servicesPath, kadriLabCasePath, multilingualPath, type Lang } from '../i18n/ui';
import { orgId as buildOrgId } from '../data/organization';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

