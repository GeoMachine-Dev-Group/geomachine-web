---
import {
  lines,
  bundles,
  DEFAULT_TIER,
  LAUNCH_SLOTS,
  LAUNCH_OPEN,
  LANG_CURRENCY,
  type Item,
  type Bundle,
  type Unit,
  type Currency,
} from '../data/catalog';
import { getCollection } from 'astro:content';
import { ui, blogPath, hasBlog, type Lang } from '../i18n/ui';
import { isPublished } from '../lib/blog';
import ServiceCard from './ServiceCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// gagraservis.ru no está publicado ahora mismo, así que la franja no puede
// enlazar al dominio: iría a un enlace muerto en la portada de los cuatro
// idiomas. Se enlaza el caso del blog, que solo existe en es y ru; en en y ka
// el nombre va sin enlace.
// Pilares que tienen al menos un artículo publicado en ESTE idioma. El badge
// "Ver artículos de X" solo sale para esos: en inglés el blog arranca con tres
// pilares, y un badge de APP llevaría a un filtro que no existe.
const blogPillars = hasBlog(lang)
  ? new Set(
      (await getCollection('blog', (e) => e.id.startsWith(`${lang}/`) && isPublished(e))).map(
        (e) => e.data.pillar,
      ),
    )
  : new Set<string>();

const GAGRA_CASE: Partial<Record<Lang, string>> = {
  es: 'gagraservis-caso-real',
  ru: 'gagraservis-realnyy-keys',
};
const gagraSlug = GAGRA_CASE[lang];
const gagraCase = hasBlog(lang) && gagraSlug ? `${blogPath[lang]}${gagraSlug}/` : null;
/** Moneda con la que se pinta el HTML antes de que corra el JS (por idioma). */
const CUR = LANG_CURRENCY[lang];

/** Opciones del selector "qué necesitas" del formulario — mismas categorías
    del catálogo, para no mantener una lista de servicios por separado. */
const serviceOptions = [...lines.map((l) => l.title[lang]), t.bundlesTitle];

const nbsp = ' ';
/** Separador de miles según el idioma de quien lee, no según la moneda:
    "1.800 €" en español, "1,800 €" en inglés, espacio duro en ruso y georgiano. */
const THOUSANDS: Record<Lang, string> = { es: '.', en: ',', ru: nbsp, ka: nbsp };
const CURRENCY_SYMBOL: Record<Currency, string> = { eur: '€', rub: '₽', gel: '₾' };
const CURRENCIES = ['eur', 'rub', 'gel'] as const;

function group(n: number, sep: string) {
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
}

function suffix(unit: Unit) {
  if (unit === 'month') return t.perMonth;
  if (unit === 'hour') return t.perHour;
  return '';
}

/** "250–400 €" · "15 000–25 000 ₽" · "750–1 200 ₾" */
function money(range: readonly number[], currency: Currency, unit: Unit) {
  const sep = THOUSANDS[lang];
  const symbol = CURRENCY_SYMBOL[currency];
  const nums = range.map((n) => group(n, sep)).join('–');
  return `${nums}${nbsp}${symbol}${suffix(unit)}`;
}

/** Plazas del hero: ocupadas (entregadas + en curso) y libres. */
const takenSlots = LAUNCH_SLOTS.completed + LAUNCH_SLOTS.inProgress;
const freeSlots = LAUNCH_SLOTS.total - takenSlots;
const slotsLeftText = t.slotsLeft
  .replace('{free}', String(freeSlots))
  .replace('{total}', String(LAUNCH_SLOTS.total));

/** "desde 250 €" (con rango) · "25 €/mes" (rango de un solo valor, nunca
    lleva "desde") · "250 €" en georgiano (t.priceFrom vacío a propósito,
    ver nota junto a la clave en ui.ts — no se traduce por declinación). */
function moneyFrom(range: readonly number[], currency: Currency, unit: Unit) {
  const sep = THOUSANDS[lang];
  const symbol = CURRENCY_SYMBOL[currency];
  const value = `${group(range[0], sep)}${nbsp}${symbol}${suffix(unit)}`;
  if (range.length === 1 || !t.priceFrom) return value;
  return `${t.priceFrom} ${value}`;
}

/** Línea pequeña bajo el precio grande: el rango completo (si lo hay) más
    la cuota recurrente (si la hay), unidos por "·". Vacía si el precio
    grande ya lo dice todo (rango de un solo valor, sin recurrente). */
function priceDetail(range: readonly number[], currency: Currency, unit: Unit, recurring?: Item['launchRecurring']) {
  const parts: string[] = [];
  if (range.length > 1) parts.push(money(range, currency, unit));
  if (recurring) parts.push(`${t.thenMonthly} ${money(recurring[currency], currency, 'month')}`);
  return parts.join(' · ');
}

/** Precio estándar tachado junto al de lanzamiento: solo el mínimo, sin "desde". */
function moneyWas(range: readonly number[], currency: Currency, unit: Unit) {
  const sep = THOUSANDS[lang];
  return `${group(range[0], sep)}${nbsp}${CURRENCY_SYMBOL[currency]}${suffix(unit)}`;
}

/**
 * Las 3 monedas viajan ya formateadas en el HTML estático, solo para la tarifa
 * activa (DEFAULT_TIER, que deciden las plazas libres). El script de Base.astro
 * elige con dataset[currency]: data-fromeur, data-detailgel, data-wasrub…
 * "was" es el precio estándar tachado y solo existe mientras haya plazas.
 */
function priceData(item: Item) {
  const rec = item[DEFAULT_TIER === 'launch' ? 'launchRecurring' : 'standardRecurring'];
  const d: Record<string, string> = { 'data-price': '' };
  for (const c of CURRENCIES) {
    d[`data-from${c}`] = moneyFrom(item[DEFAULT_TIER][c], c, item.unit);
    d[`data-detail${c}`] = priceDetail(item[DEFAULT_TIER][c], c, item.unit, rec);
    if (LAUNCH_OPEN) d[`data-was${c}`] = moneyWas(item.standard[c], c, item.unit);
  }
  return d;
}

function bundlePriceData(b: Bundle) {
  const d: Record<string, string> = { 'data-price': '' };
  for (const c of CURRENCIES) {
    d[`data-from${c}`] = moneyFrom(b[DEFAULT_TIER][c], c, 'once');
    d[`data-detail${c}`] = priceDetail(b[DEFAULT_TIER][c], c, 'once');
    if (LAUNCH_OPEN) d[`data-was${c}`] = moneyWas(b.standard[c], c, 'once');
  }
  return d;
}

/** Lo que se ve antes de que corra el JS: tarifa activa en la moneda del idioma. */
function initialFrom(item: Item) {
  return moneyFrom(item[DEFAULT_TIER][CUR], CUR, item.unit);
}

function initialDetail(item: Item) {
  const rec = item[DEFAULT_TIER === 'launch' ? 'launchRecurring' : 'standardRecurring'];
  return priceDetail(item[DEFAULT_TIER][CUR], CUR, item.unit, rec);
}

function initialWas(standard: Item['standard'], unit: Unit) {
  return LAUNCH_OPEN ? moneyWas(standard[CUR], CUR, unit) : '';
}

/** Precios de entrada del hero: el PRIMER servicio de cada línea (Landing page,
    MVP web, Auditoría de procesos), no el más barato — el mínimo de Webs sería
    "Segundo idioma", un añadido, y el de Aplicaciones "Integraciones": un
    "desde" con ellos engañaría. */
/** Marca animada del hero: "[GeoMachine▪]" se escribe letra a letra entre los
    corchetes (el nombre de marca no se traduce). Cada letra lleva su retardo;
    el CSS (.hero-mark) hace el resto y respeta prefers-reduced-motion. */
const MARK_WORD = 'GeoMachine';
const markLetters = [...MARK_WORD].map((ch, i) => ({ ch, delay: `${(0.6 + i * 0.085).toFixed(3)}s` }));

/** Página de GeoMachine Accounts en cada idioma (el slug español es distinto). */
const accountsHref: Record<Lang, string> = {
  es: '/es/servicios/app-cuentas/',
  en: '/en/services/app-accounts/',
  ru: '/ru/uslugi/app-accounts/',
  ka: '/ka/momsakhurebebi/app-accounts/',
};

const heroAnchors = ['WEB', 'APP', 'IA']
  .map((prefix) => lines.find((l) => l.prefix === prefix))
  .filter((l): l is (typeof lines)[number] => Boolean(l))
  .map((line) => ({ line, item: line.items[0] }));

// Una sola tarjeta destacada: la oferta estrella. Antes había siete etiquetas
// ("Más popular", "Más vendido", "Recomendado", "Mejor valor"…) y, con tantas, no
// destacaba ninguna. Además "Más popular" y "Más vendido" afirmaban algo que no
// se podía sostener con un solo cliente entregado. No volver a poner etiquetas de
// popularidad o de ventas sin datos reales detrás.
const featuredMap: Record<string, Record<Lang, string>> = {
  'PACK-07': {
    es: '★ Oferta estrella',
    ru: '★ Главное предложение',
    en: '★ Flagship offer',
    // ka: traducción automática, pendiente de revisión nativa.
    ka: '★ მთავარი შეთავაზება',
  },
};
---

<section class="hero hero--atelier shell">
  <span class="hero__corner hero__corner--tl" aria-hidden="true"></span>
  <span class="hero__corner hero__corner--tr" aria-hidden="true"></span>
  <span class="hero__corner hero__corner--bl" aria-hidden="true"></span>
  <span class="hero__corner hero__corner--br" aria-hidden="true"></span>

  <div class="hero-mark" role="img" aria-label={t.company}>
    <div class="hero-mark__word" aria-hidden="true">
      <svg class="hero-mark__bracket" viewBox="0 0 20 64"><path d="M17 4 H5 V60 H17"></path></svg>
      <span class="hero-mark__text">
        {markLetters.map(({ ch, delay }) => <span class="hero-mark__l" style={`animation-delay: ${delay}`}>{ch}</span>)}
        <span class="hero-mark__cursor"></span>
      </span>
      <svg class="hero-mark__bracket" viewBox="0 0 20 64"><path d="M3 4 H15 V60 H3"></path></svg>
    </div>
    <span class="hero-mark__sub" aria-hidden="true">Developer Group</span>
  </div>

  {
    LAUNCH_OPEN && (
      <p class="hero__slots">
        <span class="hero__rule" aria-hidden="true" />
        <span>{t.slotsTitle} · {slotsLeftText}</span>
        <span class="hero__rule" aria-hidden="true" />
      </p>
    )
  }

  <h1 class="hero__title">{t.heroTitle}</h1>
  <p class="hero__body">{t.heroBody}</p>

  <div class="hero__actions">
    <a class="btn btn--solid" href="#contacto">{LAUNCH_OPEN ? t.heroCtaSlot : t.ctaButton}</a>
    <a class="hero__secondary" href="https://t.me/geomachine" target="_blank" rel="noopener">{t.ctaSecondary}</a>
  </div>

  <ul class="hero__prices" aria-label={t.heroAnchorsLabel}>
    {
      heroAnchors.map(({ line, item }) => (
        <li>
          <a class="hero__price" href={`#${line.prefix.toLowerCase()}`} {...priceData(item)}>
            <span class="hero__price-name">{item.name[lang]}</span>
            <span class="price-value card__price-from hero__price-value">{initialFrom(item)}</span>
          </a>
        </li>
      ))
    }
  </ul>
  {LAUNCH_OPEN && <p class="hero__note">{t.launchNote}</p>}
</section>

<div class="proof shell">
  <ul class="proof__list" aria-label={t.proofLabel}>
    <li>
      <span class="proof__tag">{t.statusDelivered}</span>
      {gagraCase
        ? <a href={gagraCase}>gagraservis.ru</a>
        : <span>gagraservis.ru</span>}
    </li>
    <li>
      <span class="proof__tag">{t.statusDelivered}</span>
      <a href="https://abhazservis.com/" target="_blank" rel="noopener">abhazservis.com</a>
    </li>
    <li>
      <span class="proof__tag">{t.proofPrivateAi}</span>
      <span>GeoBot AI Assistant</span>
    </li>
    <li>
      <span class="proof__tag">{t.proofDesktopApp}</span>
      <a href={accountsHref[lang]}>GeoMachine Accounts</a>
    </li>
    <li>
      <span class="proof__tag">{t.statusDev}</span>
      <span>{t.devProjectName}</span>
    </li>
  </ul>
</div>

<div class="catalog-bar shell">
  <nav class="jump" aria-label={t.bundlesTitle}>
    {
      lines.map((line) => (
        <a class="jump__link" href={`#${line.prefix.toLowerCase()}`}>
          <span class="jump__code">{line.prefix}</span>
          <span>{line.title[lang]}</span>
        </a>
      ))
    }
    <a class="jump__link" href="#paquetes">
      <span class="jump__code">PACK</span>
      <span>{t.bundlesTitle}</span>
    </a>
  </nav>
  <div class="control">
    <span class="control__label" id="cur-label">{t.currencyLabel}</span>
    <div class="switch" role="group" aria-labelledby="cur-label">
      {
        CURRENCIES.map((c) => (
          <button type="button" data-set="currency" data-value={c} aria-pressed={String(c === CUR)}>
            {c.toUpperCase()} {CURRENCY_SYMBOL[c]}
          </button>
        ))
      }
    </div>
  </div>
</div>

{
  lines.map((line) => (
    <section class="line shell" id={line.prefix.toLowerCase()}>
      <header class="line__head">
        <span class="line__prefix">{line.prefix}</span>
        <div>
          <h2 class="line__title">{line.title[lang]}</h2>
          <p class="line__note">{line.note[lang]}</p>
        </div>
        {hasBlog(lang) && blogPillars.has(line.prefix) && (
          <a href={`${blogPath[lang]}#${line.prefix.toLowerCase()}`} class="line__blog-badge">
            <span>📖 {t.blogSeeArticles.replace('{tema}', line.title[lang])}</span>
          </a>
        )}
        {line.prefix === 'APP' && (
          <a href={accountsHref[lang]} class="line__blog-badge">
            <span>{t.proofDesktopApp}: GeoMachine Accounts ↗</span>
          </a>
        )}
      </header>

      <div class="cards" data-cards>
        {line.items.map((item) => {
          const featuredText = featuredMap[item.code]?.[lang];
          return (
            <ServiceCard
              code={item.code}
              name={item.name[lang]}
              time={item.time?.[lang]}
              description={item.spec[lang]}
              humanLabel={t.colService}
              human={item.human[lang]}
              priceAttrs={priceData(item)}
              initialFrom={initialFrom(item)}
              initialDetail={initialDetail(item)}
              initialWas={initialWas(item.standard, item.unit)}
              featured={Boolean(featuredText)}
              featuredLabel={featuredText}
            />
          );
        })}
      </div>
      {line.items.length > 3 && (
        <button type="button" class="cards-toggle" data-toggle-more={t.showMore} data-toggle-less={t.showLess}>
          {t.showMore}
        </button>
      )}
    </section>
  ))
}

<section class="bundles shell" id="paquetes">
  <header class="line__head">
    <span class="line__prefix">PACK</span>
    <div>
      <h2 class="line__title">{t.bundlesTitle}</h2>
      <p class="line__note">{t.bundlesNote}</p>
    </div>
  </header>

  <div class="cards" data-cards>
    {
      bundles.map((b) => {
        const featuredText = featuredMap[b.code]?.[lang];
        return (
          <ServiceCard
            code={b.code}
            name={b.name[lang]}
            time={b.time?.[lang]}
            description={b.includes[lang]}
            humanLabel={t.bundleIncludes}
            human={b.human[lang]}
            priceAttrs={bundlePriceData(b)}
            initialFrom={moneyFrom(b[DEFAULT_TIER][CUR], CUR, 'once')}
            initialDetail={priceDetail(b[DEFAULT_TIER][CUR], CUR, 'once')}
            initialWas={initialWas(b.standard, 'once')}
            featured={Boolean(featuredText)}
            featuredLabel={featuredText}
          />
        );
      })
    }
  </div>
  {bundles.length > 3 && (
    <button type="button" class="cards-toggle" data-toggle-more={t.showMore} data-toggle-less={t.showLess}>
      {t.showMore}
    </button>
  )}
</section>

<section class="faq shell">
  <h2 class="faq__title">{t.faqTitle}</h2>
  <div class="faq__list">
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ1}</h3>
      <p class="faq__a">{t.faqA1}</p>
    </div>
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ2}</h3>
      <p class="faq__a">{t.faqA2}</p>
    </div>
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ3}</h3>
      <p class="faq__a">
        {t.faqA3Before}<a href="#mnt">{t.faqMntLink}</a>{t.faqA3After}
      </p>
    </div>
  </div>
</section>

<section class="close shell" id="contacto" data-fab-hide-near>
  <div>
    <h2 class="close__title">{t.ctaTitle}</h2>
    <p class="close__body">{t.ctaBody}</p>
    <div class="close__steps">
      {t.closeSteps.map((step, i) => (
        <div>
          <span>{`0${i + 1}`}</span>
          {step}
        </div>
      ))}
    </div>
    <form
      id="contact-form"
      class="contact-form"
      data-msg-sending={t.formSending}
      data-msg-success={t.formSuccess}
      data-msg-error={t.formError}
      novalidate
    >
      <!-- honeypot: campo oculto que un humano nunca rellena -->
      <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="startedAt" />

      <label class="contact-form__field">
        <span class="control__label">{t.formName}</span>
        <input type="text" name="name" required placeholder={t.formNamePh} />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formContact}</span>
        <input type="text" name="contact" required placeholder={t.formContactPh} />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formService}</span>
        <select name="service">
          <option value="">{t.formServiceOther}</option>
          {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formBudget}</span>
        <input type="text" name="budget" placeholder={t.formBudgetPh} />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formMessage}</span>
        <textarea name="message" rows="3" required placeholder={t.formMessagePh}></textarea>
      </label>

      <div class="actions">
        <button type="submit" class="btn btn--solid">{t.ctaButton}</button>
        <a class="btn btn--ghost" href="https://t.me/geomachine" target="_blank" rel="noopener">{t.ctaSecondary}</a>
        <p class="actions__note">{t.ctaResponseTime}</p>
      </div>
      <p class="contact-form__status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>

  <div>
    <p class="terms__label">{t.terms}</p>
    <ul class="terms__list">
      {t.termsList.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<!-- Modal de contacto profesional que se abre al pulsar cualquier botón de Presupuesto -->
<div class="modal-overlay" id="contact-modal" aria-hidden="true">
  <div class="modal-window" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button type="button" class="modal-close" data-close-modal aria-label="Cerrar">&times;</button>
    <div class="modal-header">
      <h2 class="modal-title" id="modal-title">{t.modalTitle}</h2>
      <p class="modal-subtitle">{t.modalSubtitle}</p>
    </div>
    <form
      id="modal-contact-form"
      class="contact-form"
      data-msg-sending={t.formSending}
      data-msg-success={t.formSuccess}
      data-msg-error={t.formError}
      novalidate
    >
      <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="startedAt" />

      <label class="contact-form__field">
        <span class="control__label">{t.formName}</span>
        <input type="text" name="name" required placeholder={t.formNamePh} />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formContact}</span>
        <input type="text" name="contact" required placeholder={t.formContactPh} />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formService}</span>
        <select name="service" id="modal-service-select">
          <option value="">{t.formServiceOther}</option>
          {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formBudget}</span>
        <input type="text" name="budget" placeholder={t.formBudgetPh} />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formMessage}</span>
        <textarea name="message" rows="3" required placeholder={t.formMessagePh}></textarea>
      </label>

      <div class="actions">
        <button type="submit" class="btn btn--solid">{t.ctaButton}</button>
        <a class="btn btn--ghost" href="https://t.me/geomachine" target="_blank" rel="noopener">{t.ctaSecondary}</a>
        <p class="actions__note">{t.ctaResponseTime}</p>
      </div>
      <p class="contact-form__status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cards]').forEach((container) => {
    const toggle = container.nextElementSibling as HTMLButtonElement | null;
    if (!toggle || !toggle.matches('[data-toggle-more]')) return;
    toggle.addEventListener('click', () => {
      const expanded = container.classList.toggle('is-expanded');
      toggle.textContent = expanded ? toggle.dataset.toggleLess ?? '' : toggle.dataset.toggleMore ?? '';
      if (expanded) container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    });
  });

  /* Manejo unificado de envío de formularios de contacto (Sección + Modal) */
  ['contact-form', 'modal-contact-form'].forEach((id) => {
    const form = document.getElementById(id) as HTMLFormElement | null;
    if (!form) return;

    const startedAtInput = form.elements.namedItem('startedAt') as HTMLInputElement;
    if (startedAtInput) startedAtInput.value = String(Date.now());

    const status = form.querySelector<HTMLElement>('.contact-form__status')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      status.hidden = false;
      status.textContent = form.dataset.msgSending ?? '';

      try {
        const payload = Object.fromEntries(new FormData(form).entries());

        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error('send_failed');

        // No ocultar ningún campo para mantener la estructura perfecta del formulario
        form.reset();
        status.textContent = '✓ ' + (form.dataset.msgSuccess || '¡Solicitud recibida! Te responderemos en menos de 24h.');
        setTimeout(() => {
          submitBtn.disabled = false;
        }, 3000);
      } catch {
        status.textContent = '✕ ' + (form.dataset.msgError || 'Hubo un error. Por favor inténtalo de nuevo.');
        submitBtn.disabled = false;
      }
    });
  });
</script>
