---
import {
  lines,
  bundles,
  DEFAULT_TIER,
  DEFAULT_CURRENCY,
  type Item,
  type Bundle,
  type Unit,
  type Currency,
} from '../data/catalog';
import { ui, type Lang } from '../i18n/ui';
import ServiceCard from './ServiceCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

/** Opciones del selector "qué necesitas" del formulario — mismas categorías
    del catálogo, para no mantener una lista de servicios por separado. */
const serviceOptions = [...lines.map((l) => l.title[lang]), t.bundlesTitle];

const nbsp = ' ';
const CURRENCY_SYMBOL: Record<Currency, string> = { eur: '€', rub: '₽', gel: '₾' };
const CURRENCIES = ['eur', 'rub', 'gel'] as const;

function group(n: number, sep: string) {
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
}

function suffix(unit: Unit) {
  if (unit === 'month') return t.perMonth;
  if (unit === 'hour') return t.perHour;
  return '';
}

/** "250–400 €" · "15 000–25 000 ₽" · "750–1 200 ₾" */
function money(range: readonly number[], currency: Currency, unit: Unit) {
  const sep = currency === 'eur' ? '.' : nbsp;
  const symbol = CURRENCY_SYMBOL[currency];
  const nums = range.map((n) => group(n, sep)).join('–');
  return `${nums}${nbsp}${symbol}${suffix(unit)}`;
}

const TIERS = ['launch', 'standard'] as const;

/**
 * Las 6 combinaciones tarifa×moneda viajan ya formateadas en el HTML estático;
 * el script de Base.astro solo elige entre ellas con dataset[tier + currency].
 * De ahí los nombres pegados: data-launcheur, data-standardgel… y los mismos
 * con prefijo r para la cuota recurrente (data-rlauncheur).
 */
function priceData(item: Item) {
  const d: Record<string, string> = { 'data-price': '' };
  for (const tier of TIERS) {
    const rec = item[tier === 'launch' ? 'launchRecurring' : 'standardRecurring'];
    for (const c of CURRENCIES) {
      d[`data-${tier}${c}`] = money(item[tier][c], c, item.unit);
      if (rec) d[`data-r${tier}${c}`] = money(rec[c], c, 'month');
    }
  }
  return d;
}

function bundlePriceData(b: Bundle) {
  const d: Record<string, string> = { 'data-price': '' };
  for (const tier of TIERS) {
    for (const c of CURRENCIES) d[`data-${tier}${c}`] = money(b[tier][c], c, 'once');
  }
  return d;
}

/** Lo que se ve antes de que corra nada de JS: tarifa y moneda por defecto. */
function initial(item: Item) {
  return money(item[DEFAULT_TIER][DEFAULT_CURRENCY], DEFAULT_CURRENCY, item.unit);
}

function initialRecurring(item: Item) {
  const rec = item[DEFAULT_TIER === 'launch' ? 'launchRecurring' : 'standardRecurring'];
  return rec ? money(rec[DEFAULT_CURRENCY], DEFAULT_CURRENCY, 'month') : '';
}
---

<section class="hero shell">
  <p class="hero__eyebrow">{t.heroEyebrow}</p>
  <h1 class="hero__title">{t.heroTitle}</h1>
  <p class="hero__body">{t.heroBody}</p>
  <p class="hero__plain">{t.heroPlain}</p>

  <aside class="stamp" aria-hidden="true">
    <b>{t.stampLine1}</b>
    <em>1/5</em>
    <div class="stamp-dots"><i class="is-active"></i><i class="is-next"></i><i></i><i></i><i></i></div>
    <span>{t.stampLine2}</span>
  </aside>

  <div class="showcase">
    <div class="showcase__card reveal">
      <div class="showcase__header">
        <span class="showcase__seal" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14">
            <polygon points="4,0 12,0 16,4 16,12 12,16 4,16 0,12 0,4" fill="var(--accent)"></polygon>
            <path d="M4.5 8.2l2.2 2.2L11.5 5" stroke="var(--paper)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="showcase__tag">{t.statusDelivered}</span>
      </div>
      <a href="https://gagraservis.ru/" target="_blank" rel="noopener" class="showcase__link">gagraservis.ru ↗</a>
      <p class="showcase__desc">{t.deliveredProjectDesc}</p>
    </div>

    <div class="showcase__card showcase__card--dev reveal">
      <div class="showcase__header">
        <span class="credentials__bar" aria-hidden="true"></span>
        <span class="showcase__tag">{t.statusDev}</span>
      </div>
      <span class="showcase__link showcase__link--text">{t.devProjectName}</span>
      <p class="showcase__desc">{t.devProjectDesc}</p>
    </div>
  </div>
</section>

<div class="panel">
  <div class="shell panel__inner">
    <div class="control">
      <span class="control__label" id="tier-label">{t.tierLabel}</span>
      <div class="switch" role="group" aria-labelledby="tier-label">
        <button type="button" data-set="tier" data-value="launch" aria-pressed={String(DEFAULT_TIER === 'launch')}>
          {t.tierLaunch}
        </button>
        <button type="button" data-set="tier" data-value="standard" aria-pressed={String(DEFAULT_TIER === 'standard')}>
          {t.tierStandard}
        </button>
      </div>
    </div>
    <div class="control">
      <span class="control__label" id="cur-label">{t.currencyLabel}</span>
      <div class="switch" role="group" aria-labelledby="cur-label">
        {
          CURRENCIES.map((c) => (
            <button type="button" data-set="currency" data-value={c} aria-pressed={String(c === DEFAULT_CURRENCY)}>
              {c.toUpperCase()} {CURRENCY_SYMBOL[c]}
            </button>
          ))
        }
      </div>
    </div>
    <div class="control">
      <label class="control__label" for="palette-select">{t.paletteLabel}</label>
      <select id="palette-select" class="palette-select">
        {Object.entries(t.palettes).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <div class="control">
      <label class="control__label" for="cardstyle-select">{t.cardStyleLabel}</label>
      <select id="cardstyle-select" class="palette-select">
        {Object.entries(t.cardStyles).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>
    <div class="panel__notes" aria-live="polite">
      <p class="panel__note" data-note="launch">{t.launchNote}</p>
      <p class="panel__note" data-note="standard" hidden>{t.standardNote}</p>
    </div>
  </div>
</div>

<nav class="jump shell" aria-label={t.bundlesTitle}>
  {
    lines.map((line) => (
      <a class="jump__link" href={`#${line.prefix.toLowerCase()}`}>
        <span class="jump__code">{line.prefix}</span>
        <span>{line.title[lang]}</span>
      </a>
    ))
  }
  <a class="jump__link" href="#paquetes">
    <span class="jump__code">PACK</span>
    <span>{t.bundlesTitle}</span>
  </a>
</nav>

{
  lines.map((line) => (
    <section class="line shell" id={line.prefix.toLowerCase()}>
      <header class="line__head">
        <span class="line__prefix">{line.prefix}</span>
        <div>
          <h2 class="line__title">{line.title[lang]}</h2>
          <p class="line__note">{line.note[lang]}</p>
        </div>
      </header>

      <div class="cards" data-cards>
        {line.items.map((item) => (
          <ServiceCard
            code={item.code}
            name={item.name[lang]}
            time={item.time?.[lang]}
            description={item.spec[lang]}
            humanLabel={t.colService}
            human={item.human[lang]}
            priceAttrs={priceData(item)}
            initialPrice={initial(item)}
            initialRecurring={item.launchRecurring ? initialRecurring(item) : undefined}
            recurringLabel={t.thenMonthly}
            featured={item.code === 'IA-04'}
            featuredLabel={t.privacyBadge}
          />
        ))}
      </div>
      {line.items.length > 3 && (
        <button type="button" class="cards-toggle" data-toggle-more={t.showMore} data-toggle-less={t.showLess}>
          {t.showMore}
        </button>
      )}
    </section>
  ))
}

<section class="bundles shell" id="paquetes">
  <header class="line__head">
    <span class="line__prefix">PACK</span>
    <div>
      <h2 class="line__title">{t.bundlesTitle}</h2>
      <p class="line__note">{t.bundlesNote}</p>
    </div>
  </header>

  <div class="cards" data-cards>
    {
      bundles.map((b) => (
        <ServiceCard
          code={b.code}
          name={b.name[lang]}
          time={b.time?.[lang]}
          description={b.includes[lang]}
          humanLabel={t.bundleIncludes}
          human={b.human[lang]}
          priceAttrs={bundlePriceData(b)}
          initialPrice={money(b[DEFAULT_TIER][DEFAULT_CURRENCY], DEFAULT_CURRENCY, 'once')}
          featured={b.code === 'PACK-02'}
          featuredLabel={t.featuredBadge}
        />
      ))
    }
  </div>
  {bundles.length > 3 && (
    <button type="button" class="cards-toggle" data-toggle-more={t.showMore} data-toggle-less={t.showLess}>
      {t.showMore}
    </button>
  )}
</section>

<section class="faq shell">
  <h2 class="faq__title">{t.faqTitle}</h2>
  <div class="faq__list">
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ1}</h3>
      <p class="faq__a">{t.faqA1}</p>
    </div>
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ2}</h3>
      <p class="faq__a">{t.faqA2}</p>
    </div>
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ3}</h3>
      <p class="faq__a">
        {t.faqA3Before}<a href="#mnt">{t.faqMntLink}</a>{t.faqA3After}
      </p>
    </div>
  </div>
</section>

<section class="close shell" id="contacto" data-fab-hide-near>
  <div>
    <h2 class="close__title">{t.ctaTitle}</h2>
    <p class="close__body">{t.ctaBody}</p>
    <div class="close__steps">
      {t.closeSteps.map((step, i) => (
        <div>
          <span>{`0${i + 1}`}</span>
          {step}
        </div>
      ))}
    </div>
    <form
      id="contact-form"
      class="contact-form"
      data-msg-sending={t.formSending}
      data-msg-success={t.formSuccess}
      data-msg-error={t.formError}
      novalidate
    >
      <!-- honeypot: campo oculto que un humano nunca rellena -->
      <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="startedAt" />

      <label class="contact-form__field">
        <span class="control__label">{t.formName}</span>
        <input type="text" name="name" required />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formContact}</span>
        <input type="text" name="contact" required />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formService}</span>
        <select name="service">
          <option value="">{t.formServiceOther}</option>
          {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formBudget}</span>
        <input type="text" name="budget" />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formMessage}</span>
        <textarea name="message" rows="3" required></textarea>
      </label>

      <div class="actions">
        <button type="submit" class="btn btn--solid">{t.ctaButton}</button>
        <a class="btn btn--ghost" href="https://t.me/geomachine">{t.ctaSecondary}</a>
        <p class="actions__note">{t.ctaResponseTime}</p>
      </div>
      <p class="contact-form__status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>

  <div>
    <p class="terms__label">{t.terms}</p>
    <ul class="terms__list">
      {t.termsList.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-cards]').forEach((container) => {
    const toggle = container.nextElementSibling as HTMLButtonElement | null;
    if (!toggle || !toggle.matches('[data-toggle-more]')) return;
    toggle.addEventListener('click', () => {
      const expanded = container.classList.toggle('is-expanded');
      toggle.textContent = expanded ? toggle.dataset.toggleLess ?? '' : toggle.dataset.toggleMore ?? '';
      if (expanded) container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    });
  });

  /* Formulario de contacto: envía a la Netlify Function, que reenvía a
     Telegram. Los textos de estado viajan por data-attrs porque este script
     corre en el navegador, sin acceso al objeto de traducciones de Astro. */
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const startedAtInput = form.elements.namedItem('startedAt') as HTMLInputElement;
    startedAtInput.value = String(Date.now());

    const status = form.querySelector<HTMLElement>('.contact-form__status')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      status.hidden = false;
      status.textContent = form.dataset.msgSending ?? '';

      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        const res = await fetch('/.netlify/functions/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error('bad status');
        form.querySelectorAll('input, select, textarea, button').forEach((el) => {
          (el as HTMLElement).hidden = true;
        });
        status.textContent = form.dataset.msgSuccess ?? '';
      } catch {
        status.textContent = form.dataset.msgError ?? '';
        submitBtn.disabled = false;
      }
    });
  }
</script>
