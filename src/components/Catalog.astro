---
import {
  lines,
  bundles,
  DEFAULT_TIER,
  DEFAULT_CURRENCY,
  LAUNCH_SLOTS,
  type Item,
  type Bundle,
  type Unit,
  type Currency,
} from '../data/catalog';
import { ui, blogPath, type Lang } from '../i18n/ui';
import ServiceCard from './ServiceCard.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

/** Opciones del selector "qué necesitas" del formulario — mismas categorías
    del catálogo, para no mantener una lista de servicios por separado. */
const serviceOptions = [...lines.map((l) => l.title[lang]), t.bundlesTitle];

const nbsp = ' ';
const CURRENCY_SYMBOL: Record<Currency, string> = { eur: '€', rub: '₽', gel: '₾' };
const CURRENCIES = ['eur', 'rub', 'gel'] as const;

function group(n: number, sep: string) {
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, sep);
}

function suffix(unit: Unit) {
  if (unit === 'month') return t.perMonth;
  if (unit === 'hour') return t.perHour;
  return '';
}

/** "250–400 €" · "15 000–25 000 ₽" · "750–1 200 ₾" */
function money(range: readonly number[], currency: Currency, unit: Unit) {
  const sep = currency === 'eur' ? '.' : nbsp;
  const symbol = CURRENCY_SYMBOL[currency];
  const nums = range.map((n) => group(n, sep)).join('–');
  return `${nums}${nbsp}${symbol}${suffix(unit)}`;
}

const TIERS = ['launch', 'standard'] as const;

const doneSlot = LAUNCH_SLOTS.completed;
const busySlot = LAUNCH_SLOTS.completed + LAUNCH_SLOTS.inProgress;
const freeStart = busySlot + 1;
const freeEnd = LAUNCH_SLOTS.total;

/** "desde 250 €" (con rango) · "25 €/mes" (rango de un solo valor, nunca
    lleva "desde") · "250 €" en georgiano (t.priceFrom vacío a propósito,
    ver nota junto a la clave en ui.ts — no se traduce por declinación). */
function moneyFrom(range: readonly number[], currency: Currency, unit: Unit) {
  const sep = currency === 'eur' ? '.' : nbsp;
  const symbol = CURRENCY_SYMBOL[currency];
  const value = `${group(range[0], sep)}${nbsp}${symbol}${suffix(unit)}`;
  if (range.length === 1 || !t.priceFrom) return value;
  return `${t.priceFrom} ${value}`;
}

/** Línea pequeña bajo el precio grande: el rango completo (si lo hay) más
    la cuota recurrente (si la hay), unidos por "·". Vacía si el precio
    grande ya lo dice todo (rango de un solo valor, sin recurrente). */
function priceDetail(range: readonly number[], currency: Currency, unit: Unit, recurring?: Item['launchRecurring']) {
  const parts: string[] = [];
  if (range.length > 1) parts.push(money(range, currency, unit));
  if (recurring) parts.push(`${t.thenMonthly} ${money(recurring[currency], currency, 'month')}`);
  return parts.join(' · ');
}

/**
 * Las 6 combinaciones tarifa×moneda viajan ya formateadas en el HTML estático;
 * el script de Base.astro solo elige entre ellas con dataset[tier + currency].
 * De ahí los nombres pegados: data-fromlauncheur, data-detailstandardgel…
 */
function priceData(item: Item) {
  const d: Record<string, string> = { 'data-price': '' };
  for (const tier of TIERS) {
    const rec = item[tier === 'launch' ? 'launchRecurring' : 'standardRecurring'];
    for (const c of CURRENCIES) {
      d[`data-from${tier}${c}`] = moneyFrom(item[tier][c], c, item.unit);
      d[`data-detail${tier}${c}`] = priceDetail(item[tier][c], c, item.unit, rec);
    }
  }
  return d;
}

function bundlePriceData(b: Bundle) {
  const d: Record<string, string> = { 'data-price': '' };
  for (const tier of TIERS) {
    for (const c of CURRENCIES) {
      d[`data-from${tier}${c}`] = moneyFrom(b[tier][c], c, 'once');
      d[`data-detail${tier}${c}`] = priceDetail(b[tier][c], c, 'once');
    }
  }
  return d;
}

/** Lo que se ve antes de que corra nada de JS: tarifa y moneda por defecto. */
function initialFrom(item: Item) {
  return moneyFrom(item[DEFAULT_TIER][DEFAULT_CURRENCY], DEFAULT_CURRENCY, item.unit);
}

function initialDetail(item: Item) {
  const rec = item[DEFAULT_TIER === 'launch' ? 'launchRecurring' : 'standardRecurring'];
  return priceDetail(item[DEFAULT_TIER][DEFAULT_CURRENCY], DEFAULT_CURRENCY, item.unit, rec);
}

const featuredMap: Record<string, Record<Lang, string>> = {
  'WEB-02': {
    es: '★ Más popular',
    ru: '★ Популярный',
    en: '★ Most popular',
    ka: '★ პოპულარული',
  },
  'APP-02': {
    es: '🚀 Recomendado',
    ru: '🚀 Рекомендуем',
    en: '🚀 Recommended',
    ka: '🚀 რეკომენდებული',
  },
  'IA-04': {
    es: '🔒 Alta Privacidad',
    ru: '🔒 Высокая приватность',
    en: '🔒 High Privacy',
    ka: '🔒 კონფიდენციალური',
  },
  'SEO-02': {
    es: '📈 Crecimiento',
    ru: '📈 Рост продаж',
    en: '📈 Best Growth',
    ka: '📈 ზრდისთვის',
  },
  'MNT-02': {
    es: '⚡ Más vendido',
    ru: '⚡ Хит продаж',
    en: '⚡ Best seller',
    ka: '⚡ ყველაზე გაყიდვადი',
  },
  'SYS-02': {
    es: '🛡️ Esencial',
    ru: '🛡️ Базовый выбор',
    en: '🛡️ Essential',
    ka: '🛡️ აუცილებელი',
  },
  'PACK-02': {
    es: '🔥 Mejor valor',
    ru: '🔥 Лучший выбор',
    en: '🔥 Best value',
    ka: '🔥 საუკეთესო ფასი',
  },
};
---

<section class="hero shell">
  <p class="hero__eyebrow">{t.heroEyebrow}</p>
  <h1 class="hero__title">{t.heroTitle}</h1>
  <p class="hero__body">{t.heroBody}</p>
  <p class="hero__plain">{t.heroPlain}</p>

  <aside class="stamp" aria-hidden="true">
    <span class="cli-prompt">~$ sys.slots --status</span>
    <div class="cli-list">
      <div class="cli-line"><span class="cli-done">[✓] Slot {doneSlot}: COMPLETADO</span></div>
      <div class="cli-line"><span class="cli-busy">[⏳] Slot {busySlot}: EN DESARROLLO</span><span class="cli-cursor">█</span></div>
      <div class="cli-line"><span class="cli-idle">[ ] Slots {freeStart}–{freeEnd}: DISPONIBLES</span></div>
    </div>
  </aside>
</section>

<section class="showcase-section shell">
  <div class="showcase">
    <div class="showcase__card reveal">
      <div class="showcase__header">
        <span class="showcase__seal" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14">
            <polygon points="4,0 12,0 16,4 16,12 12,16 4,16 0,12 0,4" fill="var(--accent)"></polygon>
            <path d="M4.5 8.2l2.2 2.2L11.5 5" stroke="var(--paper)" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="showcase__tag">{t.statusDelivered} • 100/100 Speed</span>
      </div>
      <a href="https://gagraservis.ru/" target="_blank" rel="noopener" class="showcase__link">gagraservis.ru ↗</a>
      <p class="showcase__desc">{t.deliveredProjectDesc}</p>
    </div>

    <div class="showcase__card reveal">
      <div class="showcase__header">
        <span class="showcase__tag" style="background: rgba(34,197,94,0.15); color: #22c55e;">IA Privada • RAG Local</span>
      </div>
      <span class="showcase__link showcase__link--text">GeoBot AI Assistant</span>
      <p class="showcase__desc">Servidor de IA confidencial con DeepSeek/Llama 3 integrado en Telegram y WhatsApp. Cero costes por token.</p>
    </div>

    <div class="showcase__card reveal">
      <div class="showcase__header">
        <span class="showcase__tag" style="background: rgba(14,165,233,0.15); color: #0ea5e9;">
          {lang === 'es' ? 'App de Escritorio • Descargas' : lang === 'ru' ? 'Десктопное приложение • Скачать' : lang === 'ka' ? 'დესკტოპ აპლიკაცია • ჩამოტვირთვა' : 'Desktop App • Downloads'}
        </span>
      </div>
      <a href={lang === 'es' ? '/es/servicios/app-cuentas/' : lang === 'en' ? '/en/services/app-accounts/' : lang === 'ru' ? '/ru/uslugi/app-accounts/' : '/ka/momsakhurebebi/app-accounts/'} class="showcase__link">GeoMachine Accounts ↗</a>
      <p class="showcase__desc">
        {lang === 'es' ? 'Software local de inventario, analítica ABC y cálculo de beneficio neto real. Gratuito y privado.' :
         lang === 'ru' ? 'Локальная программа учета запасов, ABC-анализа и чистой прибыли. Бесплатно и приватно.' :
         lang === 'ka' ? 'ინვენტარისა და სუფთა მოგების ლოკალური მართვის სისტემა. უფასო და დაცული.' :
         'Local inventory control, ABC analytics, and net profit tracking software. Free and private.'}
      </p>
    </div>

    <div class="showcase__card showcase__card--dev reveal">
      <div class="showcase__header">
        <span class="credentials__bar" aria-hidden="true"></span>
        <span class="showcase__tag">{t.statusDev} • Full-Stack</span>
      </div>
      <span class="showcase__link showcase__link--text">{t.devProjectName}</span>
      <p class="showcase__desc">{t.devProjectDesc}</p>
    </div>
  </div>
</section>

<div class="panel">
  <div class="shell panel__inner">
    <div class="control">
      <span class="control__label" id="tier-label">{t.tierLabel}</span>
      <div class="switch" role="group" aria-labelledby="tier-label">
        <button type="button" data-set="tier" data-value="launch" aria-pressed={String(DEFAULT_TIER === 'launch')}>
          {t.tierLaunch}
        </button>
        <button type="button" data-set="tier" data-value="standard" aria-pressed={String(DEFAULT_TIER === 'standard')}>
          {t.tierStandard}
        </button>
      </div>
    </div>
    <div class="control">
      <span class="control__label" id="cur-label">{t.currencyLabel}</span>
      <div class="switch" role="group" aria-labelledby="cur-label">
        {
          CURRENCIES.map((c) => (
            <button type="button" data-set="currency" data-value={c} aria-pressed={String(c === DEFAULT_CURRENCY)}>
              {c.toUpperCase()} {CURRENCY_SYMBOL[c]}
            </button>
          ))
        }
      </div>
    </div>
    <div class="panel__notes" aria-live="polite">
      <p class="panel__note" data-note="launch">{t.launchNote}</p>
      <p class="panel__note" data-note="standard" hidden>{t.standardNote}</p>
    </div>
  </div>
</div>

<nav class="jump shell" aria-label={t.bundlesTitle}>
  {
    lines.map((line) => (
      <a class="jump__link" href={`#${line.prefix.toLowerCase()}`}>
        <span class="jump__code">{line.prefix}</span>
        <span>{line.title[lang]}</span>
      </a>
    ))
  }
  <a class="jump__link" href="#paquetes">
    <span class="jump__code">PACK</span>
    <span>{t.bundlesTitle}</span>
  </a>
</nav>

{
  lines.map((line) => (
    <section class="line shell" id={line.prefix.toLowerCase()}>
      <header class="line__head">
        <span class="line__prefix">{line.prefix}</span>
        <div>
          <h2 class="line__title">{line.title[lang]}</h2>
          <p class="line__note">{line.note[lang]}</p>
        </div>
        {(lang === 'es' || lang === 'ru') && (
          <a href={`${blogPath[lang as 'es' | 'ru']}#${line.prefix.toLowerCase()}`} class="line__blog-badge">
            <span>📖 {lang === 'ru' ? 'Статьи por categoría' : `Ver artículos de ${line.title[lang]}`}</span>
          </a>
        )}
      </header>

      <div class="cards" data-cards>
        {line.items.map((item) => {
          const featuredText = featuredMap[item.code]?.[lang];
          return (
            <ServiceCard
              code={item.code}
              name={item.name[lang]}
              time={item.time?.[lang]}
              description={item.spec[lang]}
              humanLabel={t.colService}
              human={item.human[lang]}
              priceAttrs={priceData(item)}
              initialFrom={initialFrom(item)}
              initialDetail={initialDetail(item)}
              featured={Boolean(featuredText)}
              featuredLabel={featuredText}
            />
          );
        })}
      </div>
      {line.items.length > 3 && (
        <button type="button" class="cards-toggle" data-toggle-more={t.showMore} data-toggle-less={t.showLess}>
          {t.showMore}
        </button>
      )}
    </section>
  ))
}

<section class="bundles shell" id="paquetes">
  <header class="line__head">
    <span class="line__prefix">PACK</span>
    <div>
      <h2 class="line__title">{t.bundlesTitle}</h2>
      <p class="line__note">{t.bundlesNote}</p>
    </div>
  </header>

  <div class="cards" data-cards>
    {
      bundles.map((b) => {
        const featuredText = featuredMap[b.code]?.[lang];
        return (
          <ServiceCard
            code={b.code}
            name={b.name[lang]}
            time={b.time?.[lang]}
            description={b.includes[lang]}
            humanLabel={t.bundleIncludes}
            human={b.human[lang]}
            priceAttrs={bundlePriceData(b)}
            initialFrom={moneyFrom(b[DEFAULT_TIER][DEFAULT_CURRENCY], DEFAULT_CURRENCY, 'once')}
            initialDetail={priceDetail(b[DEFAULT_TIER][DEFAULT_CURRENCY], DEFAULT_CURRENCY, 'once')}
            featured={Boolean(featuredText)}
            featuredLabel={featuredText}
          />
        );
      })
    }
  </div>
  {bundles.length > 3 && (
    <button type="button" class="cards-toggle" data-toggle-more={t.showMore} data-toggle-less={t.showLess}>
      {t.showMore}
    </button>
  )}
</section>

<section class="faq shell">
  <h2 class="faq__title">{t.faqTitle}</h2>
  <div class="faq__list">
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ1}</h3>
      <p class="faq__a">{t.faqA1}</p>
    </div>
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ2}</h3>
      <p class="faq__a">{t.faqA2}</p>
    </div>
    <div class="faq__item">
      <h3 class="faq__q">{t.faqQ3}</h3>
      <p class="faq__a">
        {t.faqA3Before}<a href="#mnt">{t.faqMntLink}</a>{t.faqA3After}
      </p>
    </div>
  </div>
</section>

<section class="close shell" id="contacto" data-fab-hide-near>
  <div>
    <h2 class="close__title">{t.ctaTitle}</h2>
    <p class="close__body">{t.ctaBody}</p>
    <div class="close__steps">
      {t.closeSteps.map((step, i) => (
        <div>
          <span>{`0${i + 1}`}</span>
          {step}
        </div>
      ))}
    </div>
    <form
      id="contact-form"
      class="contact-form"
      data-msg-sending={t.formSending}
      data-msg-success={t.formSuccess}
      data-msg-error={t.formError}
      novalidate
    >
      <!-- honeypot: campo oculto que un humano nunca rellena -->
      <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="startedAt" />

      <label class="contact-form__field">
        <span class="control__label">{t.formName}</span>
        <input type="text" name="name" required placeholder="Tu nombre o empresa" />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formContact}</span>
        <input type="text" name="contact" required placeholder="Email, Telegram o teléfono" />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formService}</span>
        <select name="service">
          <option value="">{t.formServiceOther}</option>
          {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formBudget}</span>
        <input type="text" name="budget" placeholder="Ej: 500–1.000 €" />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formMessage}</span>
        <textarea name="message" rows="3" required placeholder="Cuéntanos brevemente qué necesitas..."></textarea>
      </label>

      <div class="actions">
        <button type="submit" class="btn btn--solid">{t.ctaButton}</button>
        <a class="btn btn--ghost" href="https://t.me/geomachine" target="_blank" rel="noopener">{t.ctaSecondary}</a>
        <p class="actions__note">{t.ctaResponseTime}</p>
      </div>
      <p class="contact-form__status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>

  <div>
    <p class="terms__label">{t.terms}</p>
    <ul class="terms__list">
      {t.termsList.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<!-- Modal de contacto profesional que se abre al pulsar cualquier botón de Presupuesto -->
<div class="modal-overlay" id="contact-modal" aria-hidden="true">
  <div class="modal-window" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button type="button" class="modal-close" data-close-modal aria-label="Cerrar">&times;</button>
    <div class="modal-header">
      <h2 class="modal-title" id="modal-title">{t.modalTitle}</h2>
      <p class="modal-subtitle">{t.modalSubtitle}</p>
    </div>
    <form
      id="modal-contact-form"
      class="contact-form"
      data-msg-sending={t.formSending}
      data-msg-success={t.formSuccess}
      data-msg-error={t.formError}
      novalidate
    >
      <input type="text" name="website" class="visually-hidden" tabindex="-1" autocomplete="off" />
      <input type="hidden" name="startedAt" />

      <label class="contact-form__field">
        <span class="control__label">{t.formName}</span>
        <input type="text" name="name" required placeholder="Tu nombre o empresa" />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formContact}</span>
        <input type="text" name="contact" required placeholder="Email, Telegram o teléfono" />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formService}</span>
        <select name="service" id="modal-service-select">
          <option value="">{t.formServiceOther}</option>
          {serviceOptions.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formBudget}</span>
        <input type="text" name="budget" placeholder="Ej: 500–1.000 €" />
      </label>
      <label class="contact-form__field">
        <span class="control__label">{t.formMessage}</span>
        <textarea name="message" rows="3" required placeholder="Cuéntanos brevemente qué necesitas..."></textarea>
      </label>

      <div class="actions">
        <button type="submit" class="btn btn--solid">{t.ctaButton}</button>
        <a class="btn btn--ghost" href="https://t.me/geomachine" target="_blank" rel="noopener">{t.ctaSecondary}</a>
        <p class="actions__note">{t.ctaResponseTime}</p>
      </div>
      <p class="contact-form__status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-cards]').forEach((container) => {
    const toggle = container.nextElementSibling as HTMLButtonElement | null;
    if (!toggle || !toggle.matches('[data-toggle-more]')) return;
    toggle.addEventListener('click', () => {
      const expanded = container.classList.toggle('is-expanded');
      toggle.textContent = expanded ? toggle.dataset.toggleLess ?? '' : toggle.dataset.toggleMore ?? '';
      if (expanded) container.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    });
  });

  /* Manejo unificado de envío de formularios de contacto (Sección + Modal) */
  ['contact-form', 'modal-contact-form'].forEach((id) => {
    const form = document.getElementById(id) as HTMLFormElement | null;
    if (!form) return;

    const startedAtInput = form.elements.namedItem('startedAt') as HTMLInputElement;
    if (startedAtInput) startedAtInput.value = String(Date.now());

    const status = form.querySelector<HTMLElement>('.contact-form__status')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      status.hidden = false;
      status.textContent = form.dataset.msgSending ?? '';

      try {
        const payload = Object.fromEntries(new FormData(form).entries());

        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) throw new Error('send_failed');

        // No ocultar ningún campo para mantener la estructura perfecta del formulario
        form.reset();
        status.textContent = '✓ ' + (form.dataset.msgSuccess || '¡Solicitud recibida! Te responderemos en menos de 24h.');
        setTimeout(() => {
          submitBtn.disabled = false;
        }, 3000);
      } catch {
        status.textContent = '✕ ' + (form.dataset.msgError || 'Hubo un error. Por favor inténtalo de nuevo.');
        submitBtn.disabled = false;
      }
    });
  });
</script>
