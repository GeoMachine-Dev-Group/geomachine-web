---
import { ui, type Lang } from '../i18n/ui';

const [, langStr] = Astro.url.pathname.split('/');
const lang = (langStr in ui ? langStr : 'es') as Lang;
const t = ui[lang];
---
<section class="checkout-section">
  <div class="shell">
    <header class="checkout-header">
      <h1 class="checkout-header__title">{t.paymentTitle}</h1>
      <p class="checkout-header__desc">{t.paymentSubtitle}</p>
    </header>

    <div class="checkout-grid">
      
      <!-- Panel Izquierdo: Formulario -->
      <div class="checkout-panel checkout-panel--form">
        <h2 class="panel-title">1. Detalles del Proyecto</h2>
        <div id="checkout-form-container" class="contact-form" style="max-width: 100%;">
          <label class="contact-form__field">
            <span class="control__label">{t.payReference}</span>
            <input type="text" id="input-ref" placeholder="Ej: Desarrollo MVP Taxi" autocomplete="off" />
          </label>
          <label class="contact-form__field">
            <span class="control__label">{t.payTotalBudget} (€)</span>
            <input type="number" id="input-total" placeholder="Ej: 1500" min="1" step="0.01" />
          </label>
          <p class="form-help-text">El sistema calculará automáticamente el 50% de anticipo para iniciar.</p>
        </div>
      </div>

      <!-- Panel Derecho: Recibo y Botones -->
      <div class="checkout-panel checkout-panel--receipt">
        <h2 class="panel-title">2. Resumen de Pago</h2>
        
        <div class="receipt">
          <div class="receipt-row">
            <span class="receipt-label">{t.payReference}</span>
            <span class="receipt-value" id="ui-ref">-</span>
          </div>
          <div class="receipt-row">
            <span class="receipt-label">{t.payTotalBudget}</span>
            <span class="receipt-value" id="ui-total-budget">0.00 €</span>
          </div>
          
          <div class="receipt-divider"></div>
          
          <div class="receipt-row receipt-row--highlight">
            <span class="receipt-label">{t.payAdvanceAmount}</span>
            <span class="receipt-value accent" id="ui-advance">0.00 €</span>
          </div>
          <div class="receipt-row receipt-row--dim">
            <span class="receipt-label">{t.payRemainingAmount}</span>
            <span class="receipt-value" id="ui-remaining">0.00 €</span>
          </div>
        </div>

        <div id="paypal-status" class="contact-form__status" style="display: none; width: 100%; justify-content: center;"></div>
        
        <div class="paypal-buttons-wrapper">
          <div id="checkout-loading" class="checkout-loading">
            <span class="pulse"></span> Preparando pasarela segura...
          </div>
          <div id="paypal-button-container"></div>
        </div>
        
        <div class="security-badge">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
          </svg>
          Pago seguro de anticipo (50%) garantizado
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .checkout-section { padding: 4rem 0 8rem; }
  
  .checkout-header { text-align: center; margin-bottom: 3rem; }
  .checkout-header__title { font-family: var(--head); font-size: 2.5rem; letter-spacing: -.02em; color: var(--ink); margin: 0 0 .5rem; }
  .checkout-header__desc { font-size: 1.1rem; color: var(--ink-soft); }

  .checkout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .checkout-grid { grid-template-columns: 1fr 1fr; }
  }

  .checkout-panel {
    background: var(--panel-2);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }
  
  .panel-title {
    font-family: var(--data);
    font-size: .85rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 2rem;
    border-bottom: 1px solid var(--rule-soft);
    padding-bottom: 1rem;
  }

  .form-help-text {
    font-size: .85rem; color: var(--ink-soft); margin-top: 1rem; font-style: italic;
  }

  .receipt {
    background: var(--panel);
    border: 1px solid var(--rule-soft);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .receipt-row {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: .75rem; font-size: .95rem; color: var(--ink-soft);
  }
  .receipt-row:last-child { margin-bottom: 0; }
  .receipt-value { font-weight: 600; color: var(--ink); font-family: var(--data); font-size: 1.05rem;}
  
  .receipt-divider {
    height: 1px; background: repeating-linear-gradient(90deg, var(--rule) 0, var(--rule) 4px, transparent 4px, transparent 8px);
    margin: 1.25rem 0;
  }
  
  .receipt-row--highlight { font-size: 1.1rem; color: var(--ink); margin-bottom: .5rem; }
  .receipt-row--highlight .receipt-value { font-size: 1.35rem; color: var(--accent); }
  
  .receipt-row--dim { font-size: .85rem; opacity: .7; }
  .receipt-row--dim .receipt-value { font-size: .95rem; font-weight: 500; }

  .paypal-buttons-wrapper {
    position: relative;
    min-height: 55px; /* height of paypal buttons usually */
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    flex-grow: 1;
    transition: opacity 0.3s;
  }

  .checkout-loading {
    display: flex; align-items: center; gap: .75rem;
    font-family: var(--data); font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-soft);
    position: absolute;
  }
  
  .pulse {
    display: inline-block; width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent); animation: plate-pulse 2s infinite ease-in-out;
  }

  .security-badge {
    display: flex; justify-content: center; align-items: center; gap: .5rem;
    font-size: .8rem; color: var(--stamp); margin-top: 1rem;
  }
  .security-badge svg { color: var(--stamp); }

</style>

<script>
  import { loadScript } from "@paypal/paypal-js";

  const PAYPAL_CLIENT_ID = "test"; 
  let currentTotal = 0;
  let currentRef = '';
  
  document.addEventListener('DOMContentLoaded', async () => {
    const params = new URLSearchParams(window.location.search);
    const totalRaw = params.get('total');
    const refRaw = params.get('ref');
    
    const inputTotal = document.getElementById('input-total') as HTMLInputElement;
    const inputRef = document.getElementById('input-ref') as HTMLInputElement;
    const formContainer = document.getElementById('checkout-form-container');

    if (totalRaw && !isNaN(parseFloat(totalRaw))) {
      inputTotal.value = totalRaw;
      if (refRaw) inputRef.value = refRaw;
    }

    const updateTotalUI = () => {
      currentTotal = parseFloat(inputTotal.value) || 0;
      currentRef = inputRef.value || 'Proyecto General';
      
      const advance = (currentTotal * 0.5).toFixed(2);
      const remaining = (currentTotal - parseFloat(advance)).toFixed(2);

      document.getElementById('ui-ref').textContent = currentRef;
      document.getElementById('ui-total-budget').textContent = `${currentTotal.toFixed(2)} €`;
      document.getElementById('ui-advance').textContent = `${advance} €`;
      document.getElementById('ui-remaining').textContent = `${remaining} €`;
      
      const btnWrapper = document.getElementById('paypal-button-container');
      if (currentTotal > 0) {
        btnWrapper.style.pointerEvents = 'auto';
        btnWrapper.style.opacity = '1';
        btnWrapper.style.filter = 'none';
      } else {
        btnWrapper.style.pointerEvents = 'none';
        btnWrapper.style.opacity = '0.4';
        btnWrapper.style.filter = 'grayscale(100%)';
      }
    };

    inputTotal.addEventListener('input', updateTotalUI);
    inputRef.addEventListener('input', updateTotalUI);
    updateTotalUI();

    try {
      const paypal = await loadScript({
        "client-id": PAYPAL_CLIENT_ID,
        currency: "EUR",
        intent: "capture"
      });

      document.getElementById('checkout-loading').style.display = 'none';

      if (paypal && paypal.Buttons) {
        paypal.Buttons({
          style: { color: 'gold', shape: 'rect', label: 'pay', height: 45 },
          createOrder: async () => {
            if (currentTotal <= 0) throw new Error("Importe inválido");
            const response = await fetch('/.netlify/functions/create-paypal-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ totalAmount: currentTotal, invoiceRef: currentRef, serviceName: currentRef })
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Error al crear la orden');
            return data.orderId;
          },
          onApprove: async (data) => {
            const response = await fetch('/.netlify/functions/capture-paypal-order', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId: data.orderID })
            });
            const captureData = await response.json();
            const statusEl = document.getElementById('paypal-status');
            statusEl.style.display = 'flex';
            if (response.ok) {
              statusEl.className = 'contact-form__status'; 
              statusEl.textContent = "¡Anticipo procesado con éxito!";
              document.getElementById('paypal-button-container').style.display = 'none';
              formContainer.style.pointerEvents = 'none';
              formContainer.style.opacity = '0.5';
            } else {
              statusEl.className = 'contact-form__status';
              statusEl.style.color = '#ef4444';
              statusEl.style.backgroundColor = 'rgba(239, 68, 68, 0.12)';
              statusEl.style.borderColor = 'rgba(239, 68, 68, 0.3)';
              statusEl.textContent = captureData.error || "Error al procesar el pago.";
            }
          },
          onError: (err) => {
            console.error('PayPal Checkout Error:', err);
            const statusEl = document.getElementById('paypal-status');
            statusEl.style.display = 'flex';
            statusEl.className = 'contact-form__status';
            statusEl.style.color = '#ef4444';
            statusEl.style.backgroundColor = 'rgba(239, 68, 68, 0.12)';
            statusEl.style.borderColor = 'rgba(239, 68, 68, 0.3)';
            statusEl.textContent = "Ocurrió un error con el widget de pago.";
          }
        }).render("#paypal-button-container");
      }
    } catch (error) {
      console.error("Failed to load PayPal", error);
      document.getElementById('checkout-loading').innerHTML = 'Error al conectar con PayPal.';
    }
  });
</script>
