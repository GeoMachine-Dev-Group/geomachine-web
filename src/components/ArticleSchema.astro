---
/**
 * JSON-LD para un artículo del blog. No redeclara la organización: Base.astro
 * la emite una vez por página (ver src/data/organization.ts) y este bloque
 * solo referencia su @id — así author/publisher siempre resuelven al mismo
 * ProfessionalService rico, sin una segunda versión "Organization" mínima.
 */
import { ui, type Lang } from '../i18n/ui';
import { orgId as buildOrgId } from '../data/organization';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  pageUrl: string;
  /** Portada del artículo; si falta, el OG genérico del idioma. */
  image?: string;
}
const { lang, title, description, pubDate, updatedDate, pageUrl } = Astro.props;
const t = ui[lang];
const site = new URL(pageUrl).origin;
const orgId = buildOrgId(site);
/** image es obligatorio para que BlogPosting sea elegible a Rich Results: la
    portada del artículo (src/pages/og/blog/) o, si no llega, el OG del idioma. */
const image = Astro.props.image ?? `${site}/og/og-${lang}.png`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      headline: title,
      description,
      image,
      datePublished: pubDate.toISOString(),
      ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
      inLanguage: t.htmlLang,
      author: { '@id': orgId },
      publisher: { '@id': orgId },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
