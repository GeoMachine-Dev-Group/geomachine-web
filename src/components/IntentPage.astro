---
/**
 * Plantilla de las páginas por intención (B5): «quiero una app de taxi»,
 * «quiero un directorio local»… Cada página (TaxiAppPage, DirectoryPage) solo
 * aporta sus textos, sus rutas y el código del paquete (o de los servicios
 * sueltos) del catálogo; el precio y el plazo salen de catalog.ts para que no
 * se desfasen.
 *
 * Regla de contenido: no son páginas puerta. Todo lo que dicen sale de un
 * proyecto propio o de cliente que se puede abrir, con su estado real a la
 * fecha, incluido lo que todavía no hay. Mismo formato visual que
 * CaseKadriLabPage (clases .app-*). El ka (2026-11-03) está traducido desde el inglés
 * y revisado por Romeo Mikava.
 */
import Base from '../layouts/Base.astro';
import { servicesPath, ui, type IntentLang } from '../i18n/ui';
import { orgId as buildOrgId } from '../data/organization';
import { bundles, lines, LAUNCH_OPEN, LANG_CURRENCY } from '../data/catalog';
import { intents, intentByKey, intentUi } from '../data/intents';

export interface IntentContent {
  title: string;
  description: string;
  tagline: string;
  headline: string;
  lead: string;
  honest: string;
  visit: string;
  partsTitle: string;
  parts: { title: string; text: string }[];
  priceTitle: string;
  priceTimeLabel: string;
  priceLaterLabel: string;
  priceNote: string;
  afterTitle: string;
  after: string[];
  afterNote: string;
  asideTitle: string;
  asideText: string;
  asideLink: string;
  asideHref: string;
  readTitle: string;
  read: { text: string; href: string }[];
  ctaTitle: string;
  ctaButton: string;
  backToHome: string;
}

interface Props {
  lang: IntentLang;
  paths: Record<IntentLang, string>;
  /** Un paquete (precio cerrado)… */
  packCode?: string;
  /** …o servicios sueltos, que se pintan con su rango («150–250 €»). */
  itemCodes?: string[];
  /** Proyecto que se puede abrir. Sin él no hay botón (una IA privada no tiene nada público). */
  proofUrl?: string;
  content: IntentContent;
}
const { lang, paths, packCode, itemCodes = [], proofUrl, content: t } = Astro.props;

const pack = packCode ? bundles.find((b) => b.code === packCode) : undefined;
if (packCode && !pack) throw new Error(`IntentPage: no existe el paquete ${packCode} en catalog.ts`);
const allItems = lines.flatMap((l) => l.items);
const items = itemCodes.map((code) => {
  const item = allItems.find((i) => i.code === code);
  if (!item) throw new Error(`IntentPage: no existe el servicio ${code} en catalog.ts`);
  return item;
});
if (!pack && items.length === 0) throw new Error('IntentPage: falta packCode o itemCodes');

const nbsp = ' ';
const THOUSANDS: Record<IntentLang, string> = { es: '.', en: ',', ru: nbsp, ka: nbsp };
const SYMBOL = { eur: '€', rub: '₽', gel: '₾' } as const;
const currency = LANG_CURRENCY[lang];
const money = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, THOUSANDS[lang])}${nbsp}${SYMBOL[currency]}`;
const range = (r: readonly number[]) => (r.length > 1 && r[0] !== r[1] ? `${money(r[0]!).replace(`${nbsp}${SYMBOL[currency]}`, '')}–${money(r[1]!)}` : money(r[0]!));
const tierOf = (o: { launch: typeof bundles[number]['launch']; standard: typeof bundles[number]['standard'] }) =>
  (LAUNCH_OPEN ? o.launch : o.standard)[currency];
const price = pack ? range(tierOf(pack)) : null;
const priceLater = pack && LAUNCH_OPEN ? range(pack.standard[currency]) : null;
// Servicios con cuota (IA): «1.500–3.500 € + 90–200 €/mes». Sin la cuota, el precio engañaría.
const withMonthly = (once: string, recurring?: typeof bundles[number]['launch']) =>
  recurring ? `${once} + ${range(recurring[currency])}${ui[lang].perMonth}` : once;
const itemRows = items.map((i) => ({
  name: i.name[lang],
  spec: i.spec[lang],
  time: i.time?.[lang],
  price: withMonthly(range(tierOf(i)), LAUNCH_OPEN ? i.launchRecurring : i.standardRecurring),
  later: LAUNCH_OPEN ? withMonthly(range(i.standard[currency]), i.standardRecurring) : null,
}));
// Para el JSON-LD: el precio más bajo de lo que se ofrece.
const amount = Math.min(...(pack ? [tierOf(pack)[0]!] : items.map((i) => tierOf(i)[0]!)));
const serviceName = pack ? pack.name[lang] : items.map((i) => i.name[lang]).join(' + ');

const site = 'https://geomachine.es';
const hreflangAlternates = [
  { hreflang: 'x-default', href: `${site}${paths.es}` },
  ...(Object.keys(paths) as IntentLang[]).map((l) => ({ hreflang: l, href: `${site}${paths[l]}` })),
];
const pageUrl = `${site}${paths[lang]}`;
const orgId = buildOrgId(site);
const external = t.asideHref.startsWith('http');
// Ruta de navegación y «otros servicios»: salen de intents.ts por la ruta de esta página.
const self = intents.find((i) => i.paths.es === paths.es);
if (!self) throw new Error(`IntentPage: ${paths.es} no está en src/data/intents.ts`);
const related = self.related.map((k) => intentByKey[k]);
const iu = intentUi[lang];
const homeUrl = `${site}${servicesPath[lang]}`;
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  pageUrl={pageUrl}
  hreflangAlternates={hreflangAlternates}
  schema="none"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': `${pageUrl}#webpage`,
          url: pageUrl,
          name: t.title,
          description: t.description,
          inLanguage: lang,
          isPartOf: { '@id': orgId },
          mainEntity: { '@id': `${pageUrl}#service` },
          breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
        },
        {
          '@type': 'BreadcrumbList',
          '@id': `${pageUrl}#breadcrumb`,
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: iu.home, item: homeUrl },
            { '@type': 'ListItem', position: 2, name: self.title[lang], item: pageUrl },
          ],
        },
        {
          '@type': 'Service',
          '@id': `${pageUrl}#service`,
          name: serviceName,
          serviceType: t.tagline,
          provider: { '@id': orgId },
          offers: { '@type': 'Offer', price: amount, priceCurrency: currency.toUpperCase() },
        },
      ],
    })} />
  </Fragment>

  <nav class="crumbs shell" aria-label="breadcrumb">
    <ol>
      <li><a href={servicesPath[lang]}>{iu.home}</a></li>
      <li aria-current="page">{self.title[lang]}</li>
    </ol>
  </nav>

  <section class="hero app-hero shell">
    <p class="hero__eyebrow">{t.tagline}</p>
    <h1 class="hero__title">{t.headline}</h1>
    <p class="hero__body">{t.lead}</p>
    <p class="hero__body case-note">{t.honest}</p>

    {proofUrl && (
      <div class="app-hero__downloads">
        <a href={proofUrl} class="app-download app-download--primary" target="_blank" rel="noopener">
          {t.visit} ↗
        </a>
      </div>
    )}
  </section>

  <section class="shell app-section">
    <h2 class="app-section__title">{t.partsTitle}</h2>
    <div class="app-features app-features--two">
      {t.parts.map(({ title, text }) => (
        <div class="app-feature">
          <h3 class="app-feature__title">{title}</h3>
          <p class="app-feature__text">{text}</p>
        </div>
      ))}
    </div>

    <div class="app-panel">
      <div>
        <h2 class="app-panel__title">{t.priceTitle}</h2>
        {pack && (
          <>
            <p class="app-panel__text"><strong>{pack.name[lang]}: {price}</strong></p>
            {priceLater && <p class="app-panel__text">{t.priceLaterLabel} {priceLater}</p>}
            {pack.time && <p class="app-panel__text">{t.priceTimeLabel} {pack.time[lang]}</p>}
            <ul class="app-panel__steps case-points">
              {pack.includes[lang].map((item) => <li>{item}</li>)}
            </ul>
          </>
        )}
        {itemRows.map((r) => (
          <div class="case-points">
            <p class="app-panel__text"><strong>{r.name}: {r.price}</strong></p>
            {r.later && <p class="app-panel__text">{t.priceLaterLabel} {r.later}</p>}
            <p class="app-panel__text">{r.spec}{r.time && ` · ${t.priceTimeLabel} ${r.time}`}</p>
          </div>
        ))}
        <p class="app-panel__text case-note">{t.priceNote}</p>
      </div>

      <div>
        <h2 class="app-panel__title">{t.afterTitle}</h2>
        <ul class="app-panel__steps">
          {t.after.map((item) => <li>{item}</li>)}
        </ul>
        <p class="app-panel__text case-note">{t.afterNote}</p>
      </div>
    </div>

    <div class="app-panel">
      <div>
        <h2 class="app-panel__title">{t.asideTitle}</h2>
        <p class="app-panel__text">{t.asideText}</p>
        <p class="app-panel__text case-note">
          {external
            ? <a href={t.asideHref} target="_blank" rel="noopener">{t.asideLink} ↗</a>
            : <a href={t.asideHref}>{t.asideLink}</a>}
        </p>
      </div>
      {t.read.length > 0 && (
        <div>
          <h2 class="app-panel__title">{t.readTitle}</h2>
          <ul class="app-panel__steps">
            {t.read.map((r) => <li><a href={r.href}>{r.text}</a></li>)}
          </ul>
        </div>
      )}
    </div>

    <div class="case-cta">
      <h2 class="app-panel__title">{t.ctaTitle}</h2>
      <a href={`${servicesPath[lang]}#contacto`} class="app-download app-download--primary">{t.ctaButton}</a>
    </div>

    <section class="intents intents--related" aria-labelledby="related-title">
      <h2 class="app-panel__title" id="related-title">{iu.related}</h2>
      <ul class="intents__list">
        {related.map((i) => (
          <li class="intents__item">
            <a class="intents__link" href={i.paths[lang]}>
              <span class="intents__name">{i.title[lang]}</span>
              <span class="intents__text">{i.text[lang]}</span>
              <span class="intents__more">{iu.more} →</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="app-back">
      <a href={servicesPath[lang]}>← {t.backToHome}</a>
    </div>
  </section>
</Base>
