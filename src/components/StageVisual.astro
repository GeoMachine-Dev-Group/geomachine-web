---
/**
 * Ilustración estática de la pieza 3D de un servicio: las mismas poses que
 * anima el lienzo (src/scripts/stage3d/*-shapes.ts), proyectadas a SVG en el
 * build con la misma cámara (projection.ts). Es lo que se ve sin JS, sin WebGL
 * o mientras carga three.js; el lienzo la sustituye con un fundido. Colores
 * por tokens (clases .pv-* en global.css).
 *
 * Cada línea aporta su dibujo en DRAW. `key` es único por SVG de la página
 * (línea, servicio y forma): de él salen los id de los degradados, que no
 * pueden repetirse entre SVG.
 */
import type { StageKind } from '../scripts/stage3d/kinds';
import { projector } from '../scripts/stage3d/projection';
import { webSvg } from '../scripts/stage3d/web-svg';
import { kitSvg } from '../scripts/stage3d/glass-kit-svg';
import { APP_KIT } from '../scripts/stage3d/app-shapes';
import { SYS_KIT } from '../scripts/stage3d/sys-shapes';
import { iaSvg } from '../scripts/stage3d/ia-svg';
import { mntSvg } from '../scripts/stage3d/mnt-svg';
import { seoSvg } from '../scripts/stage3d/seo-shapes';
import { packSvg } from '../scripts/stage3d/pack-shapes';

type Draw = (index: number, W: number, H: number, key: string) => string;

/** Con la cámara de WEB: sombra de contacto y luego la pieza. */
const withWebCamera = (draw: (index: number, pr: ReturnType<typeof projector>) => string): Draw =>
  (index, W, H, key) => {
    const pr = projector(W, H, key);
    return pr.glow() + draw(index, pr);
  };

const DRAW: Record<StageKind, Draw> = {
  web: withWebCamera(webSvg),
  app: withWebCamera((i, pr) => kitSvg(APP_KIT, i, pr)),
  sys: withWebCamera((i, pr) => kitSvg(SYS_KIT, i, pr)),
  ia: withWebCamera(iaSvg),
  mnt: withWebCamera(mntSvg),
  // SEO y PACK traen cámara propia (makeCamera) y dibujan ellos su sombra.
  seo: (i, W, H, key) => seoSvg(i, W, H, `pv-glow-${key}`),
  pack: (i, W, H, key) => packSvg(i, W, H, `pv-glow-${key}`),
};

interface Props {
  kind: StageKind;
  index: number;
  /** 'tall': columna derecha a toda altura (escritorio); 'wide': banda de
      arriba (≤ 860 px). El CSS enseña la que toca. */
  shape: 'tall' | 'wide';
}
const { kind, index, shape } = Astro.props;

const W = shape === 'tall' ? 440 : 460;
const H = shape === 'tall' ? 560 : 220;
const svg = DRAW[kind](index, W, H, `${kind}-${index}-${shape}`);
---

<svg class={`stage__visual-svg stage__visual-svg--${shape}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" set:html={svg} />
