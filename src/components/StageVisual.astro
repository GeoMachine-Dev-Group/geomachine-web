---
/**
 * Ilustración estática de la pieza 3D de un servicio: las mismas poses que
 * anima el lienzo (src/scripts/stage3d/*-shapes.ts), proyectadas a SVG en el
 * build con la misma cámara (project.ts). Es lo que se ve sin JS, sin WebGL o
 * mientras carga three.js; el lienzo la sustituye con un fundido. Colores por
 * tokens (clases .pv-* en global.css). Cada línea aporta su función *Svg.
 */
import { projector, type Projector } from '../scripts/stage3d/project';
import { webSvg } from '../scripts/stage3d/web-svg';
import { iaSvg } from '../scripts/stage3d/ia-svg';
import { mntSvg } from '../scripts/stage3d/mnt-svg';

const DRAW: Record<string, (index: number, pr: Projector) => string> = {
  web: webSvg,
  ia: iaSvg,
  mnt: mntSvg,
};

interface Props {
  kind: 'web' | 'ia' | 'mnt';
  index: number;
  /** 'tall': columna derecha a toda altura (escritorio); 'wide': banda de
      arriba (≤ 860 px). El CSS enseña la que toca. */
  shape: 'tall' | 'wide';
}
const { kind, index, shape } = Astro.props;

const W = shape === 'tall' ? 440 : 460;
const H = shape === 'tall' ? 560 : 220;
const pr = projector(W, H, `${kind}-${index}-${shape}`);
const svg = pr.glow() + DRAW[kind](index, pr);
---

<svg class={`stage__visual-svg stage__visual-svg--${shape}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" set:html={svg} />
