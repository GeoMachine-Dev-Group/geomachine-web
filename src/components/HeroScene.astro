---
/* Escultura de partículas del hero: una nube de luz que toma la forma de cada
   línea del catálogo. Aquí va el hueco, el rótulo y el cargador; la escena
   (WebGL 2 a pelo, sin librerías) está en src/scripts/hero-scene y se descarga
   aparte, con la página ya cargada, el hero a la vista y WebGL por hardware.

   Sin WebGL, con ahorro de datos o si la escena falla, se pinta un póster de la
   propia escultura. Se dibuja en el <canvas>, en 2D, y no como imagen: un lienzo
   no es candidato a LCP y así no le quita el puesto al titular. El póster se
   regenera con scripts/hero-poster.mjs. */
import { lines } from '../data/catalog';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const data = lines.map((l) => ({ id: l.prefix, name: l.title[lang] }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="hero-scene" data-hero-scene data-lines={JSON.stringify(data)}>
  <canvas class="hero-scene__canvas" aria-hidden="true"></canvas>
  <a class="hero-scene__caption" href={`#${data[0].id.toLowerCase()}`} data-hero-caption>
    <span class="hero-scene__index" data-hero-index>{pad(1)} / {pad(data.length)}</span>
    <span class="hero-scene__name" data-hero-name>{data[0].name}</span>
  </a>
</div>

<script>
  import poster from '../assets/hero/escultura.webp?url';

  const host = document.querySelector<HTMLElement>('[data-hero-scene]');

  function hasFastWebGL(): boolean {
    try {
      const probe = document.createElement('canvas');
      // failIfMajorPerformanceCaveat descarta el renderizado por software.
      const gl = probe.getContext('webgl2', { failIfMajorPerformanceCaveat: true });
      if (!gl) return false;
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      return true;
    } catch {
      return false;
    }
  }

  function showPoster(host: HTMLElement) {
    if (host.dataset.heroScene === 'poster') return;
    host.dataset.heroScene = 'poster';
    host.classList.remove('is-live');
    const img = new Image();
    img.decoding = 'async';
    img.onload = () => {
      // Lienzo nuevo: uno que ya ha tenido contexto WebGL no admite 2D.
      const old = host.querySelector('canvas');
      const canvas = document.createElement('canvas');
      canvas.className = 'hero-scene__canvas';
      canvas.setAttribute('aria-hidden', 'true');
      old?.replaceWith(canvas);
      const paint = () => {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        if (!w || !h) return;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        // Entera y centrada, como la escultura en vivo.
        const k = Math.min(canvas.height / img.naturalHeight, canvas.width / img.naturalWidth);
        const dw = img.naturalWidth * k;
        const dh = img.naturalHeight * k;
        canvas.getContext('2d')?.drawImage(img, (canvas.width - dw) / 2, (canvas.height - dh) / 2, dw, dh);
      };
      paint();
      new ResizeObserver(paint).observe(host);
      requestAnimationFrame(() => host.classList.add('is-live'));
    };
    img.src = poster;
  }

  if (host) {
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    const start = () => {
      if (saveData || !hasFastWebGL()) return showPoster(host);
      // La escena avisa con este evento si pierde el contexto WebGL.
      host.addEventListener('hero-scene:lost', () => showPoster(host), { once: true });
      import('../scripts/hero-scene/index')
        .then((m) => m.mount(host))
        .catch(() => showPoster(host));
    };
    const whenVisible = () => {
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        // Después de pintar: ni la escena ni el póster compiten con el primer render.
        if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
        else setTimeout(start, 150);
      });
      io.observe(host);
    };
    if (document.readyState === 'complete') whenVisible();
    else window.addEventListener('load', whenVisible, { once: true });
  }
</script>
