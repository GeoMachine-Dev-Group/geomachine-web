    step2: '2. დამატებითი მოდულები (არასავალდებულო)',
    estimatedTotal: 'სავარაუდო ბიუჯეტი:',
    estimatedTime: 'სავარაუდო ვადა:',
    days: 'დღე',
    weeks: 'კვირა',
    cta: 'ამ ბიუჯეტის მოთხოვნა',
    badgeLaunch: '-25% გაშვების ფასდაკლება',
