    backToHome: "Назад в GeoMachine",
  },
  ka: {
    title: "GeoMachine Accounts — ინვენტარისა და მცირე ბიზნესის მოგების მართვა",
    description: "ლოკალური ინვენტარის მართვის პროგრამა, ABC ანალიტიკა და სუფთა მოგების აღრიცხვა. 100% კონფიდენციალური SQLite ბაზით.",
    tagline: "ინვენტარისა და მოგების მართვის სისტემა",
    headline: "საუკეთესო სისტემა თქვენი მარაგებისა და სუფთა მოგების საკონტროლებლად",
    lead: "მართეთ ყოველდღიური ინვენტარი სწრაფად, დაინახეთ თითოეული პროდუქტის რეალური მოგება და ავტომატიზაცია გაუკეთეთ შესყიდვებს ABC ანალიზის მეშვეობით. ინტერნეტის გარეშე, 100% ლოკალური და დაცული.",
    downloadWin: "ჩამოტვირთვა Windows-ისთვის (.exe)",
    downloadLin: "ჩამოტვირთვა Linux-ისთვის (Portable)",
    detailsTitle: "მთავარი მახასიათებლები",
    feature1Title: "100% ლოკალური და დაცული",
    feature1Desc: "თქვენი მონაცემები ინახება ლოკალურ SQLite ბაზაში. ღრუბლის გარეშე, რაც უზრუნველყოფს კომერციული საიდუმლოების დაცვას.",
    feature2Title: "პროგნოზირებადი ABC ანალიზი",
    feature2Desc: "ავტომატურად ახდენს პროდუქტების კლასიფიკაციას A, B და C კატეგორიებად და გთავაზობთ კვირის შეკვეთის რაოდენობას.",
    feature3Title: "ანალიტიკა და ისტორია",
    feature3Desc: "ინტეგრირებული გრაფიკები, რომლებიც ადარებენ შემოსავლებს სუფთა მოგებასთან კვირის დღეების მიხედვით.",
    feature4Title: "კატალოგის სრული მართვა",
    feature4Desc: "თვითღირებულების, გასაყიდი ფასისა და მიღებული საქონლის მყისიერი რედაქტირება ცხრილზე ორმაგი დაწკაპუნებით.",
    seoSectionTitle: "დისტრიბუცია და ცნობადობა",
    seoDesc: "GeoMachine-ის პარტნიორებისთვის, პროგრამის ქვედა ნაწილში ჩაშენებულია ციფრული ბეჭედი. კლიენტებისთვის მიწოდებისას ან თქვენს მაღაზიაში გამოყენებისას, ბეჭედზე დაწკაპუნებით მომხმარებლები პირდაპირ გადადიან თქვენს Google Business-ის 5-ვარსკვლავიან შეფასებებზე.",
    installationTitle: "გაშვების ინსტრუქცია",
    instStep1: "1. ჩამოტვირთეთ თქვენი პლატფორმის შესაბამისი ფაილი.",
    instStep2: "2. გაუშვით ფაილი. Windows-ზე SmartScreen გაფრთხილებისას დააწკაპუნეთ 'More info' და შემდეგ 'Run anyway'.",
    instStep3: "3. SQLite მონაცემთა ბაზა ავტომატურად შეიქმნება იმავე საქაღალდეში, სადაც მდებარეობს ფაილი.",
    backToHome: "GeoMachine-ზე დაბრუნება",
  }
};

const t = content[lang];
const site = 'https://geomachine.es';

// Rutas locales de descarga para alternates hreflang
const hreflangAlternates = [
  { hreflang: 'es', href: `${site}/es/servicios/app-cuentas/` },
  { hreflang: 'en', href: `${site}/en/services/app-accounts/` },
  { hreflang: 'ru', href: `${site}/ru/uslugi/app-accounts/` },
  { hreflang: 'ka', href: `${site}/ka/momsakhurebebi/app-accounts/` },
];
const pageUrl = hreflangAlternates.find((a) => a.hreflang === lang)!.href;
const orgId = buildOrgId(site);
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  pageUrl={pageUrl}
  hreflangAlternates={hreflangAlternates}
  schema="none"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': `${pageUrl}#webpage`,
          url: pageUrl,
          name: t.title,
          description: t.description,
          inLanguage: lang,
          isPartOf: { '@id': orgId },
          about: { '@id': orgId },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': `${pageUrl}#app`,
          name: 'GeoMachine Accounts',
          operatingSystem: 'Windows, Linux',
          applicationCategory: 'BusinessApplication',
          downloadUrl:
            'https://github.com/GeoMachine-Dev-Group/geomachine-web/releases/download/accounts-app-v1/GeoMachineAccounts.exe',
          provider: { '@id': orgId },
          offers: {
            '@type': 'Offer',
            price: '0.00',
            priceCurrency: 'EUR',
          },
        },
      ],
    })} />
  </Fragment>

  <section class="hero shell">
    <p class="hero__eyebrow">{t.tagline}</p>
    <h1 class="hero__title" style="max-width: 25ch; white-space: normal;">{t.headline}</h1>
    <p class="hero__body" style="max-width: 60ch;">{t.lead}</p>
    
    <div style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 1rem;">
      <a href="https://github.com/GeoMachine-Dev-Group/geomachine-web/releases/download/accounts-app-v1/GeoMachineAccounts.exe" class="card__button card__button--featured" style="text-decoration: none; padding: 0.9rem 2rem; font-size: 1rem; font-weight: bold; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.5rem; background: var(--accent); color: var(--paper); border: none;">
        <span>🪟</span> {t.downloadWin}
      </a>
      <a href="https://github.com/GeoMachine-Dev-Group/geomachine-web/releases/download/accounts-app-v1/GeoMachineAccounts.tar.gz" class="card__button" style="text-decoration: none; padding: 0.9rem 2rem; font-size: 1rem; font-weight: bold; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.5rem; background: var(--panel-2); color: var(--ink); border: 1px solid var(--rule);">
        <span>🐧</span> {t.downloadLin}
      </a>
    </div>
  </section>

  <section class="shell" style="padding-bottom: 5rem;">
    <h2 style="font-family: var(--display); font-size: 2rem; font-weight: bold; margin-bottom: 2rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.5rem;">
      {t.detailsTitle}
    </h2>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
      <div style="background: var(--panel); border: 1px solid var(--rule); padding: 1.5rem; border-radius: 8px;">
        <h3 style="font-family: var(--display); font-size: 1.25rem; font-weight: bold; color: var(--accent); margin: 0 0 0.75rem 0;">
          🔒 {t.feature1Title}
        </h3>
        <p style="margin: 0; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5;">
          {t.feature1Desc}
        </p>
      </div>

      <div style="background: var(--panel); border: 1px solid var(--rule); padding: 1.5rem; border-radius: 8px;">
        <h3 style="font-family: var(--display); font-size: 1.25rem; font-weight: bold; color: var(--accent); margin: 0 0 0.75rem 0;">
          🏷️ {t.feature2Title}
        </h3>
        <p style="margin: 0; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5;">
          {t.feature2Desc}
        </p>
      </div>

      <div style="background: var(--panel); border: 1px solid var(--rule); padding: 1.5rem; border-radius: 8px;">
        <h3 style="font-family: var(--display); font-size: 1.25rem; font-weight: bold; color: var(--accent); margin: 0 0 0.75rem 0;">
          📈 {t.feature3Title}
        </h3>
        <p style="margin: 0; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5;">
          {t.feature3Desc}
        </p>
      </div>

      <div style="background: var(--panel); border: 1px solid var(--rule); padding: 1.5rem; border-radius: 8px;">
        <h3 style="font-family: var(--display); font-size: 1.25rem; font-weight: bold; color: var(--accent); margin: 0 0 0.75rem 0;">
          📝 {t.feature4Title}
        </h3>
        <p style="margin: 0; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5;">
          {t.feature4Desc}
        </p>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 3rem; background: var(--panel-2); border: 1px solid var(--rule); padding: 2.5rem; border-radius: 12px; margin-bottom: 4rem;">
      <div>
        <h2 style="font-family: var(--display); font-size: 1.75rem; font-weight: bold; margin: 0 0 1rem 0; color: var(--ink);">
          ⚙️ {t.installationTitle}
        </h2>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; font-size: 0.95rem; color: var(--ink-soft); line-height: 1.6;">
          <li>{t.instStep1}</li>
          <li>{t.instStep2}</li>
          <li>{t.instStep3}</li>
        </ul>
      </div>

      <div>
        <h2 style="font-family: var(--display); font-size: 1.75rem; font-weight: bold; margin: 0 0 1rem 0; color: var(--stamp);">
          🏢 {t.seoSectionTitle}
        </h2>
        <p style="margin: 0; font-size: 0.95rem; color: var(--ink-soft); line-height: 1.6;">
          {t.seoDesc}
        </p>
      </div>
    </div>

    <div style="text-align: center;">
      <a href="/" style="font-family: var(--data); text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.1em; color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 4px; transition: color 0.2s, border-color 0.2s;">
        ← {t.backToHome}
      </a>
    </div>
  </section>
</Base>
