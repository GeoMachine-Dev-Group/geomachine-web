---
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n/ui';
import { orgId as buildOrgId } from '../data/organization';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const content = {
  es: {
    title: "GeoMachine Accounts — control de stock y beneficio",
    description: "Programa local para controlar el inventario, ver el beneficio neto real por producto y planificar compras con análisis ABC. Sin nube y sin suscripción.",
    tagline: "Software de Gestión de Inventario y Cuentas",
    headline: "El sistema definitivo para controlar tu stock y calcular tu beneficio neto",
    lead: "Gestiona tu inventario diario de forma rápida, visualiza tu margen real de ganancia por producto y automatiza tu logística de reordenación con análisis ABC. Sin internet, sin suscripciones, 100% local y privado.",
    downloadWin: "Descargar para Windows (.exe)",
    downloadLin: "Descargar para Linux (Portable)",
    detailsTitle: "Características principales",
    feature1Title: "100% Local y Privado",
    feature1Desc: "Tus datos se almacenan en una base de datos local SQLite. Sin subidas a la nube, garantizando absoluta privacidad comercial.",
    feature2Title: "Análisis ABC Predictivo",
    feature2Desc: "Clasifica automáticamente tus productos en categorías A, B y C según su volumen de ingresos, sugiriendo compras para la semana.",
    feature3Title: "Estadísticas e Historial",
    feature3Desc: "Gráficos integrados que comparan ingresos frente a beneficio neto real por días de la semana y muestran las tendencias históricas.",
    feature4Title: "Gestión de Productos Completa",
    feature4Desc: "Edición instantánea con doble clic de costos, precios, stock inicial y entradas de mercancía de forma visual.",
    seoSectionTitle: "Distribución y Visibilidad",
    seoDesc: "Para partners de GeoMachine, esta herramienta incluye en su pie de página un Sello Digital. Al entregarse a tus clientes o usarla en tu negocio, puedes enlazar el botón interactivo de soporte directamente a tu perfil de Google Business Reviews para acumular valoraciones de 5 estrellas automáticamente.",
    installationTitle: "Instrucciones de Lanzamiento",
    instStep1: "1. Descarga el ejecutable para tu plataforma.",
    instStep2: "2. Ejecuta el archivo. En Windows, si aparece el filtro SmartScreen, haz clic en 'Más información' y luego en 'Ejecutar de todos modos'.",
    instStep3: "3. La base de datos SQLite se creará automáticamente en la misma carpeta que el archivo ejecutable.",
    backToHome: "Volver a GeoMachine",
  },
  en: {
    title: "GeoMachine Accounts — stock and profit control",
    description: "Local software to track inventory, see real net profit per product and plan restocking with ABC analysis. No cloud, no subscription, SQLite inside.",
    tagline: "Inventory & Profit Management Software",
    headline: "The ultimate system to control your stock and calculate true net profit",
    lead: "Manage your daily inventory fast, visualize real profit margins per product, and automate your reorder logistics with ABC analysis. Offline, no subscriptions, 100% local and private.",
    downloadWin: "Download for Windows (.exe)",
    downloadLin: "Download for Linux (Portable)",
    detailsTitle: "Key Features",
    feature1Title: "100% Local & Private",
    feature1Desc: "Your data is stored in a local SQLite database. No cloud uploads, ensuring absolute commercial privacy.",
    feature2Title: "Predictive ABC Analysis",
    feature2Desc: "Automatically classifies products into A, B, and C categories based on revenue, suggesting orders for the week.",
    feature3Title: "Analytics & History",
    feature3Desc: "Integrated charts comparing revenues against net profit by day of the week, showing historical trends.",
    feature4Title: "Full Product Management",
    feature4Desc: "Instant double-click editing of costs, prices, initial stock, and received stock in a visual grid.",
    seoSectionTitle: "Distribution & Visibility",
    seoDesc: "For GeoMachine partners, this tool features an interactive Digital Seal in the footer. When deployed to customers or used in your shop, clicking the seal can redirect users to your Google Business Profile to collect 5-star reviews automatically.",
    installationTitle: "Launch Instructions",
    instStep1: "1. Download the executable file for your platform.",
    instStep2: "2. Run the file. On Windows, if SmartScreen flags it, click 'More info' and then select 'Run anyway'.",
    instStep3: "3. The SQLite database will be initialized automatically in the same folder as the executable.",
    backToHome: "Back to GeoMachine",
  },
  ru: {
    title: "GeoMachine Accounts — учёт склада и прибыли",
    description: "Локальная программа для учёта склада, расчёта чистой прибыли по каждому товару и планирования закупок по ABC-анализу. Без облака и без подписки.",
    tagline: "Программа управления инвентарем и счетами",
    headline: "Лучшая система для контроля склада и расчета чистой прибыли",
    lead: "Управляйте ежедневным инвентарем быстро, отслеживайте реальную маржинальность каждого товара и автоматизируйте закупки с помощью встроенного ABC-анализа. Без интернета, без подписок, полностью локально.",
    downloadWin: "Скачать для Windows (.exe)",
    downloadLin: "Скачать для Linux (Portable)",
    detailsTitle: "Основные возможности",
    feature1Title: "100% Локально и Приватно",
    feature1Desc: "Все данные хранятся в локальной базе SQLite. Никаких облачных серверов, гарантируя полную конфиденциальность бизнеса.",
    feature2Title: "Прогностический ABC-анализ",
    feature2Desc: "Автоматически делит товары на категории A, B и C по выручке, выдавая рекомендации по заказу на выходные и неделю.",
    feature3Title: "Аналитика и история",
    feature3Desc: "Встроенные графики динамики продаж и прибыли по дням недели, наглядно показывающие рентабельность.",
    feature4Title: "Управление каталогом",
    feature4Desc: "Мгновенное редактирование цен, себестоимости, стартовых остатков и поступления товара по двойному клику.",
    seoSectionTitle: "Дистрибуция и Видимость",
    seoDesc: "Для партнеров GeoMachine в подвал программы встроен интерактивный Цифровой Скрипт. При установке клиентам или использовании на торговых точках, клик по логотипу ведет на форму отзывов Google Business Maps для автоматического сбора 5 звезд.",
    installationTitle: "Инструкция по запуску",
    instStep1: "1. Скачайте исполняемый файл для вашей платформы.",
    instStep2: "2. Запустите файл. В Windows при предупреждении SmartScreen нажмите 'Подробнее', затем 'Выполнить в любом случае'.",
    instStep3: "3. Локальная база SQLite создается автоматически в той же папке, где находится программа.",
    backToHome: "Назад в GeoMachine",
  },
  ka: {
    title: "GeoMachine Accounts — მარაგი და მოგება",
    description: "ლოკალური პროგრამა მარაგის აღრიცხვისთვის, თითოეული პროდუქტის წმინდა მოგების დათვლისა და ABC-ანალიზით შესყიდვების დაგეგმვისთვის. ღრუბლისა და გამოწერის გარეშე.",
    tagline: "ინვენტარისა და მოგების მართვის სისტემა",
    headline: "საუკეთესო სისტემა თქვენი მარაგებისა და სუფთა მოგების საკონტროლებლად",
    lead: "მართეთ ყოველდღიური ინვენტარი სწრაფად, დაინახეთ თითოეული პროდუქტის რეალური მოგება და ავტომატიზაცია გაუკეთეთ შესყიდვებს ABC ანალიზის მეშვეობით. ინტერნეტის გარეშე, 100% ლოკალური და დაცული.",
    downloadWin: "ჩამოტვირთვა Windows-ისთვის (.exe)",
    downloadLin: "ჩამოტვირთვა Linux-ისთვის (Portable)",
    detailsTitle: "მთავარი მახასიათებლები",
    feature1Title: "100% ლოკალური და დაცული",
    feature1Desc: "თქვენი მონაცემები ინახება ლოკალურ SQLite ბაზაში. ღრუბლის გარეშე, რაც უზრუნველყოფს კომერციული საიდუმლოების დაცვას.",
    feature2Title: "პროგნოზირებადი ABC ანალიზი",
    feature2Desc: "ავტომატურად ახდენს პროდუქტების კლასიფიკაციას A, B და C კატეგორიებად და გთავაზობთ კვირის შეკვეთის რაოდენობას.",
    feature3Title: "ანალიტიკა და ისტორია",
    feature3Desc: "ინტეგრირებული გრაფიკები, რომლებიც ადარებენ შემოსავლებს სუფთა მოგებასთან კვირის დღეების მიხედვით.",
    feature4Title: "კატალოგის სრული მართვა",
    feature4Desc: "თვითღირებულების, გასაყიდი ფასისა და მიღებული საქონლის მყისიერი რედაქტირება ცხრილზე ორმაგი დაწკაპუნებით.",
    seoSectionTitle: "დისტრიბუცია და ცნობადობა",
    seoDesc: "GeoMachine-ის პარტნიორებისთვის, პროგრამის ქვედა ნაწილში ჩაშენებულია ციფრული ბეჭედი. კლიენტებისთვის მიწოდებისას ან თქვენს მაღაზიაში გამოყენებისას, ბეჭედზე დაწკაპუნებით მომხმარებლები პირდაპირ გადადიან თქვენს Google Business-ის 5-ვარსკვლავიან შეფასებებზე.",
    installationTitle: "გაშვების ინსტრუქცია",
    instStep1: "1. ჩამოტვირთეთ თქვენი პლატფორმის შესაბამისი ფაილი.",
    instStep2: "2. გაუშვით ფაილი. Windows-ზე SmartScreen გაფრთხილებისას დააწკაპუნეთ 'More info' და შემდეგ 'Run anyway'.",
    instStep3: "3. SQLite მონაცემთა ბაზა ავტომატურად შეიქმნება იმავე საქაღალდეში, სადაც მდებარეობს ფაილი.",
    backToHome: "GeoMachine-ზე დაბრუნება",
  }
};

const t = content[lang];
const site = 'https://geomachine.es';

// Rutas locales de descarga para alternates hreflang
const hreflangAlternates = [
  // x-default al español, el idioma por defecto del sitio. Va primero pero no
  // rompe pageUrl: esa búsqueda compara con el idioma de la página, nunca con
  // "x-default".
  { hreflang: 'x-default', href: `${site}/es/servicios/app-cuentas/` },
  { hreflang: 'es', href: `${site}/es/servicios/app-cuentas/` },
  { hreflang: 'en', href: `${site}/en/services/app-accounts/` },
  { hreflang: 'ru', href: `${site}/ru/uslugi/app-accounts/` },
  { hreflang: 'ka', href: `${site}/ka/momsakhurebebi/app-accounts/` },
];
const pageUrl = hreflangAlternates.find((a) => a.hreflang === lang)!.href;
const orgId = buildOrgId(site);

// Los binarios van como assets de una GitHub Release, no versionados en el repo
// (ver AGENTS.md §7: 90 MB de .exe/.tar.gz ya hubo que purgar del historial).
const RELEASE =
  'https://github.com/GeoMachine-Dev-Group/geomachine-web/releases/download/accounts-app-v1';

const features = [
  { icon: '🔒', title: t.feature1Title, desc: t.feature1Desc },
  { icon: '🏷️', title: t.feature2Title, desc: t.feature2Desc },
  { icon: '📈', title: t.feature3Title, desc: t.feature3Desc },
  { icon: '📝', title: t.feature4Title, desc: t.feature4Desc },
];
---

<Base
  lang={lang}
  title={t.title}
  description={t.description}
  pageUrl={pageUrl}
  hreflangAlternates={hreflangAlternates}
  schema="none"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebPage',
          '@id': `${pageUrl}#webpage`,
          url: pageUrl,
          name: t.title,
          description: t.description,
          inLanguage: lang,
          isPartOf: { '@id': orgId },
          about: { '@id': orgId },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': `${pageUrl}#app`,
          name: 'GeoMachine Accounts',
          operatingSystem: 'Windows, Linux',
          applicationCategory: 'BusinessApplication',
          downloadUrl: `${RELEASE}/GeoMachineAccounts.exe`,
          provider: { '@id': orgId },
          offers: {
            '@type': 'Offer',
            price: '0.00',
            priceCurrency: 'EUR',
          },
        },
      ],
    })} />
  </Fragment>

  <section class="hero app-hero shell">
    <p class="hero__eyebrow">{t.tagline}</p>
    <h1 class="hero__title">{t.headline}</h1>
    <p class="hero__body">{t.lead}</p>

    <div class="app-hero__downloads">
      <a href={`${RELEASE}/GeoMachineAccounts.exe`} class="app-download app-download--primary">
        <span>🪟</span> {t.downloadWin}
      </a>
      <a href={`${RELEASE}/GeoMachineAccounts.tar.gz`} class="app-download">
        <span>🐧</span> {t.downloadLin}
      </a>
    </div>
  </section>

  <section class="shell app-section">
    <h2 class="app-section__title">{t.detailsTitle}</h2>

    <div class="app-features">
      {features.map(({ icon, title, desc }) => (
        <div class="app-feature">
          <h3 class="app-feature__title">{icon} {title}</h3>
          <p class="app-feature__text">{desc}</p>
        </div>
      ))}
    </div>

    <div class="app-panel">
      <div>
        <h2 class="app-panel__title">⚙️ {t.installationTitle}</h2>
        <ul class="app-panel__steps">
          <li>{t.instStep1}</li>
          <li>{t.instStep2}</li>
          <li>{t.instStep3}</li>
        </ul>
      </div>

      <div>
        <h2 class="app-panel__title app-panel__title--stamp">🏢 {t.seoSectionTitle}</h2>
        <p class="app-panel__text">{t.seoDesc}</p>
      </div>
    </div>

    <div class="app-back">
      <a href="/">← {t.backToHome}</a>
    </div>
  </section>
</Base>
