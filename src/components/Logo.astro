---
/**
 * Símbolo de marca — dirección "Corchetes" (lienzo de variantes de logo,
 * 2026-09-13): dos corchetes rectos y un bloque de cursor dentro. Los colores
 * salen de los tokens de global.css (--ink para los corchetes, --accent para
 * el cursor), así que el símbolo sigue a la paleta en vez de fijar hex propios.
 * El favicon (public/favicon.svg) es este mismo trazado sobre fondo #10160f.
 */
interface Props {
  width?: number | string;
  height?: number | string;
  class?: string;
}

const { width = 28, height = 28, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height={height}
  class:list={['gm-logo', className]}
  aria-hidden="true"
>
  <path class="gm-logo__bracket" d="M25 11 H15 V53 H25"></path>
  <path class="gm-logo__bracket" d="M39 11 H49 V53 H39"></path>
  <rect class="gm-logo__cursor" x="27" y="35" width="10" height="10"></rect>
</svg>

<style>
  .gm-logo__bracket {
    stroke: var(--ink);
    stroke-width: 6;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .gm-logo__cursor {
    fill: var(--accent);
  }
</style>
