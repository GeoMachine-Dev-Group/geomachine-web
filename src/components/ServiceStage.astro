---
import StageVisual from './StageVisual.astro';
import type { StageKind } from '../scripts/stage3d/kinds';

/**
 * Configurador por línea (diseño C). Sustituye a la rejilla de tarjetas: una
 * pestaña por servicio y un "escenario" grande con el servicio activo.
 *
 * Contrato que no se puede romper:
 * - Todo el contenido de todos los servicios sale en el HTML (un tabpanel por
 *   servicio, los inactivos con `hidden`). Sin JS, el <noscript> de
 *   Catalog.astro los enseña todos apilados y oculta las pestañas.
 * - El precio es un elemento con `data-price` y los data-from/detail/was de
 *   cada moneda, con los mismos hijos .card__price-*: el script de Base.astro
 *   los repinta al cambiar de moneda igual que antes. Base.astro escribe el
 *   texto entero en .card__price-from; este componente lo vuelve a partir en
 *   «desde» + cifra + «/mes» para darles tamaños distintos.
 */
export interface StageItem {
  code: string;
  name: string;
  time?: string;
  /** Plazo máximo en días naturales, para la fecha estimada (solo con JS). */
  days?: number;
  /** Lo que incluye, ya partido en líneas para la lista de comprobación. */
  checklist: string[];
  human: string;
  priceAttrs: Record<string, string>;
  initialFrom: string;
  initialDetail: string;
  initialWas?: string;
  featuredLabel?: string;
}

interface Props {
  /** Prefijo de la línea en minúsculas (web, app, paquetes…): base de los id. */
  id: string;
  /** Nombre accesible de la lista de pestañas (el título de la línea). */
  label: string;
  items: StageItem[];
  ctaLabel: string;
  /** Opción del selector "qué necesitas" del modal que se preselecciona. */
  ctaService: string;
  /** Separador de miles del idioma, para el contador del precio. */
  thousands: string;
  labels: { benefit: string; eta: string; prev: string; next: string };
  /** Pieza 3D de la línea (ver stage3d/kinds.ts): hueco en cada panel con
      su ilustración SVG, que el lienzo sustituye al cargar. */
  visual?: StageKind;
}

const { id, label, items, ctaLabel, ctaService, thousands, labels, visual } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

/** Mismo reparto que hace el script en el navegador: lo de antes de la cifra
    ("desde", "от"), la cifra con su moneda y lo de después ("/mes"). */
const NUM = /\d[\d.,   ]*\d|\d/;
function priceParts(text: string) {
  const m = text.match(NUM);
  if (!m || m.index === undefined) return { pre: '', num: text, post: '' };
  const pre = text.slice(0, m.index).trim();
  const rest = text.slice(m.index);
  const slash = rest.indexOf('/');
  return slash < 0 ? { pre, num: rest, post: '' } : { pre, num: rest.slice(0, slash), post: rest.slice(slash) };
}
---

<div class:list={['stage', 'reveal', { 'stage--visual': visual }]} data-stage data-thousands={thousands} data-eta={labels.eta} data-visual={visual}>
  <div class="stage__bar">
    <div class="stage__tabs" role="tablist" aria-label={label}>
      {
        items.map((item, i) => (
          <button
            type="button"
            role="tab"
            class="stage__tab"
            id={`${id}-tab-${i}`}
            aria-controls={`${id}-panel-${i}`}
            aria-selected={String(i === 0)}
            tabindex={i === 0 ? '0' : '-1'}
          >
            <span class="stage__tab-code">{item.code}</span>
            <span class="stage__tab-name">{item.name}</span>
          </button>
        ))
      }
      <span class="stage__indicator" aria-hidden="true"></span>
    </div>
    <p class="stage__progress" aria-hidden="true">
      <span data-stage-index>01</span><span class="stage__progress-sep">/</span>{pad(items.length)}
    </p>
  </div>

  <div class="stage__viewport">
    <button type="button" class="stage__nav stage__nav--prev" data-stage-step="-1" aria-label={labels.prev} hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" /></svg>
    </button>
    {
      items.map((item, i) => {
        const price = priceParts(item.initialFrom);
        /* Lista y cita. Sin pieza 3D van en la columna derecha; con pieza, en
           la columna de texto entre el precio y el CTA, y la derecha es la
           pieza a toda altura. */
        const details = (
          <Fragment>
            <ul class="stage__check">
              {item.checklist.map((line, n) => (
                <li style={`--i: ${n}`}>
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 8.5l2.75 2.75L12 5.5" /></svg>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
            <figure class="stage__quote">
              <figcaption class="stage__quote-label">{labels.benefit}</figcaption>
              <blockquote>
                <p>{item.human}</p>
              </blockquote>
            </figure>
          </Fragment>
        );
        return (
          <section
            class="stage__panel"
            role="tabpanel"
            id={`${id}-panel-${i}`}
            aria-labelledby={`${id}-tab-${i}`}
            hidden={i !== 0}
          >
            <div class:list={['stage__main', { 'stage__main--text': visual }]}>
              <div class="stage__top">
                <p class="stage__meta">
                  <span class="stage__code">{item.code}</span>
                  {item.featuredLabel && <span class="stage__badge">{item.featuredLabel}</span>}
                </p>
                <h3 class="stage__name">{item.name}</h3>

                <div class="stage__price card__price" {...item.priceAttrs}>
                  <span class="price-value card__price-from stage__price-from">
                    {price.pre && <span class="stage__price-pre">{price.pre}</span>}
                    {price.pre && ' '}
                    <span class="stage__price-num">{price.num}</span>
                    {price.post && <span class="stage__price-post">{price.post}</span>}
                  </span>
                  <p class="price-value card__price-detail" hidden={!item.initialDetail}>{item.initialDetail}</p>
                  <span class="price-value card__price-was" hidden={!item.initialWas}>{item.initialWas}</span>
                </div>
              </div>

              {visual && details}

              <div class="stage__bottom">
                <div class="stage__foot">
                  <a class="btn btn--solid stage__cta" href="#contacto" data-service={ctaService} data-fab-hide-near>
                    {ctaLabel}
                  </a>
                  {item.time && (
                    <span class="stage__time">
                      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="6.25" /><path d="M8 4.5V8l2.5 1.5" /></svg>
                      {item.time}
                    </span>
                  )}
                </div>
                {item.days && <p class="stage__eta" data-days={item.days} hidden></p>}
              </div>
            </div>

            {!visual && <div class="stage__side">{details}</div>}
            {visual && (
              <div class="stage__visual" aria-hidden="true">
                <div class="stage__visual-box">
                  <StageVisual kind={visual} index={i} shape="tall" />
                  <StageVisual kind={visual} index={i} shape="wide" />
                </div>
              </div>
            )}
          </section>
        );
      })
    }
    <button type="button" class="stage__nav stage__nav--next" data-stage-step="1" aria-label={labels.next} hidden>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg>
    </button>
  </div>
</div>

<script>
  import type { StageKind } from '../scripts/stage3d/kinds';
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const NUM = /\d[\d.,   ]*\d|\d/; // separador: punto, coma, espacio duro o fino

  function priceParts(text: string) {
    const m = text.match(NUM);
    if (!m || m.index === undefined) return { pre: '', num: text, post: '' };
    const pre = text.slice(0, m.index).trim();
    const rest = text.slice(m.index);
    const slash = rest.indexOf('/');
    return slash < 0 ? { pre, num: rest, post: '' } : { pre, num: rest.slice(0, slash), post: rest.slice(slash) };
  }

  /** Pinta el precio en tres piezas. El textContent final sigue siendo el
      mismo texto que escribe Base.astro ("desde 250 €/mes"). */
  function renderPrice(out: HTMLElement, text: string) {
    const { pre, num, post } = priceParts(text);
    const nodes: Node[] = [];
    const span = (cls: string, txt: string) => {
      const s = document.createElement('span');
      s.className = cls;
      s.textContent = txt;
      return s;
    };
    if (pre) nodes.push(span('stage__price-pre', pre), document.createTextNode(' '));
    nodes.push(span('stage__price-num', num));
    if (post) nodes.push(span('stage__price-post', post));
    out.replaceChildren(...nodes);
  }

  /* Base.astro repinta con textContent al cargar y al cambiar de moneda; aquí
     se vuelve a partir. Solo reacciona cuando el texto llega "plano". */
  const priceObserver = new MutationObserver((records) => {
    records.forEach((r) => {
      const out = r.target as HTMLElement;
      if (!out.querySelector('.stage__price-num')) renderPrice(out, out.textContent ?? '');
    });
  });

  /* Contadores en curso: se cancelan si cambia la moneda, para que un
     fotograma tardío no escriba la cifra de la moneda anterior. */
  const tweens = new Map<HTMLElement, number>();

  /** Juegos de formas 3D por línea. Cada uno es un trozo aparte que trae
      three.js consigo; añadir una línea es añadir aquí su import(). */
  const VISUALS: Record<StageKind, () => Promise<{ mount(stage: HTMLElement): (() => void) | null }>> = {
    web: () => import('../scripts/stage3d/web'),
    app: () => import('../scripts/stage3d/app'),
    sys: () => import('../scripts/stage3d/sys'),
    ia: () => import('../scripts/stage3d/ia'),
    mnt: () => import('../scripts/stage3d/mnt'),
  };
  new MutationObserver(() => {
    tweens.forEach((raf) => cancelAnimationFrame(raf));
    tweens.clear();
  }).observe(root, { attributes: true, attributeFilter: ['data-currency'] });

  function numberIn(text: string) {
    const m = text.match(NUM);
    return m ? Number(m[0].replace(/\D/g, '')) : 0;
  }

  /** Cuenta la cifra hasta su valor en 400 ms con salida suave. Los pasos
      intermedios se redondean a la escala del precio (decenas para 250,
      centenas para 1.800, millares para 174.000) para que una cifra a medio
      contar no parezca un precio raro; el último fotograma es el texto real. */
  function tweenPrice(panel: HTMLElement, fromValue: number, sep: string) {
    const cell = panel.querySelector<HTMLElement>('[data-price]');
    const out = cell?.querySelector<HTMLElement>('.card__price-from');
    if (!cell || !out) return;
    const target = cell.dataset['from' + (root.dataset.currency ?? '')] ?? out.textContent ?? '';
    const prev = tweens.get(out);
    if (prev) cancelAnimationFrame(prev);
    tweens.delete(out);
    const m = target.match(NUM);
    const end = m ? Number(m[0].replace(/\D/g, '')) : 0;
    if (!m || m.index === undefined || reduce.matches || end === fromValue) {
      renderPrice(out, target);
      return;
    }
    const own = m[0].match(/[^\d]/)?.[0] ?? sep;
    const head = target.slice(0, m.index);
    const tail = target.slice(m.index + m[0].length);
    const step = Math.pow(10, Math.max(0, String(end).length - 2));
    const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, own);
    const dur = 400;
    const t0 = performance.now();
    const frame = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      if (p >= 1) {
        tweens.delete(out);
        renderPrice(out, target);
        return;
      }
      const eased = 1 - Math.pow(1 - p, 3);
      const v = Math.round((fromValue + (end - fromValue) * eased) / step) * step;
      renderPrice(out, head + fmt(v) + tail);
      tweens.set(out, requestAnimationFrame(frame));
    };
    tweens.set(out, requestAnimationFrame(frame));
  }

  /** Reinicia la entrada escalonada de la lista de comprobación. */
  function replayChecklist(panel: HTMLElement) {
    if (reduce.matches) return;
    panel.classList.remove('is-entering');
    void panel.offsetWidth;
    panel.classList.add('is-entering');
  }

  /* Fecha estimada: hoy + plazo máximo, con el formato del idioma de la
     página (día y mes corto). Solo en el navegador: en el HTML estático la
     fecha se quedaría vieja. */
  const dateFmt = new Intl.DateTimeFormat(root.lang || undefined, { day: 'numeric', month: 'short' });

  document.querySelectorAll<HTMLElement>('[data-stage]').forEach((stage) => {
    const tablist = stage.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...stage.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? '') as HTMLElement);
    const viewport = stage.querySelector<HTMLElement>('.stage__viewport')!;
    const indicator = stage.querySelector<HTMLElement>('.stage__indicator')!;
    const indexOut = stage.querySelector<HTMLElement>('[data-stage-index]');
    const sep = stage.dataset.thousands ?? '.';
    let current = 0;

    stage.classList.add('is-ready');

    stage.querySelectorAll<HTMLElement>('.stage__eta[data-days]').forEach((eta) => {
      const d = new Date();
      d.setDate(d.getDate() + Number(eta.dataset.days));
      eta.textContent = (stage.dataset.eta ?? '').replace('{date}', dateFmt.format(d));
      eta.hidden = false;
    });

    panels.forEach((p) => {
      const out = p.querySelector<HTMLElement>('.card__price-from');
      if (!out) return;
      if (!out.querySelector('.stage__price-num')) renderPrice(out, out.textContent ?? '');
      priceObserver.observe(out, { childList: true });
    });

    /* Indicador de cobre: una barra de 100 px que se mueve y se estira solo con
       transform (translate + scaleX), medida contra la lista de pestañas. */
    function placeIndicator() {
      const tab = tabs[current];
      const inset = parseFloat(getComputedStyle(tab).paddingLeft) || 0;
      const x = tab.offsetLeft + inset;
      const y = tab.offsetTop + tab.offsetHeight;
      const w = Math.max(8, tab.offsetWidth - inset * 2);
      indicator.style.transform = `translate(${x}px, ${y}px) scaleX(${w / 100})`;
    }

    /** En móvil la tira se desplaza: lleva la pestaña activa a la vista sin
        mover la página en vertical (scrollIntoView sí la movería). */
    function revealTab(tab: HTMLElement) {
      const behavior = reduce.matches ? 'auto' : 'smooth';
      const left = tab.offsetLeft - 16;
      const right = tab.offsetLeft + tab.offsetWidth + 16 - tablist.clientWidth;
      if (tablist.scrollLeft > left) tablist.scrollTo({ left, behavior });
      else if (tablist.scrollLeft < right) tablist.scrollTo({ left: right, behavior });
    }

    /** La máscara de la derecha avisa de que la tira sigue; al llegar al
        final se quita para no difuminar la última pestaña. */
    function syncScrollEnd() {
      const end = tablist.scrollLeft + tablist.clientWidth >= tablist.scrollWidth - 2;
      tablist.classList.toggle('is-scroll-end', end);
    }
    tablist.addEventListener('scroll', syncScrollEnd, { passive: true });

    /** Termina en seco cualquier cambio a medias. */
    function settle() {
      panels.forEach((p, i) => {
        p.getAnimations().forEach((a) => a.cancel());
        p.classList.remove('is-leaving');
        p.hidden = i !== current;
      });
    }

    function select(next: number, focus = false) {
      const n = tabs.length;
      next = ((next % n) + n) % n;
      if (next === current) return;
      const dir = next > current ? 1 : -1;
      const prevPanel = panels[current];
      const fromValue = numberIn(prevPanel.querySelector('.card__price-from')?.textContent ?? '');
      const height = viewport.offsetHeight;
      current = next;

      tabs.forEach((t, i) => {
        const on = i === next;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      if (indexOut) indexOut.textContent = String(next + 1).padStart(2, '0');
      if (focus) tabs[next].focus({ preventScroll: true });
      placeIndicator();
      revealTab(tabs[next]);

      const nextPanel = panels[next];
      /* Gancho para lo que quiera seguir al servicio activo (la pieza 3D de
         src/scripts/stage3d/ lo escucha). */
      stage.dispatchEvent(new CustomEvent('stage:change', { detail: { index: next, direction: dir } }));
      if (reduce.matches) {
        settle();
        tweenPrice(nextPanel, fromValue, sep);
        return;
      }

      /* El escenario mide lo que el panel activo. Mientras dura el cambio, el
         saliente sale del flujo (posición absoluta, sin animar posición) y se
         funde, el entrante entra deslizándose desde el lado al que se viaja,
         y el contenedor guarda con min-block-size el alto que tenía para que
         lo de debajo no salte. Ese mínimo se suelta cuando el escenario sale
         de pantalla, donde un cambio de alto ya no se ve. */
      settle();
      prevPanel.hidden = false;
      prevPanel.classList.add('is-leaving');
      const kept = parseFloat(viewport.style.minBlockSize) || 0;
      viewport.style.minBlockSize = `${Math.max(kept, height)}px`;

      prevPanel.animate(
        [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: `translateX(${-16 * dir}px)` }],
        { duration: 220, easing: 'ease-in', fill: 'forwards' },
      );
      const enter = nextPanel.animate(
        [{ opacity: 0, transform: `translateX(${32 * dir}px)` }, { opacity: 1, transform: 'none' }],
        { duration: 300, easing: 'cubic-bezier(.2,.8,.2,1)' },
      );
      enter.finished.then(settle).catch(() => {});
      replayChecklist(nextPanel);
      tweenPrice(nextPanel, fromValue, sep);
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));

    /* Flechas a los lados del escenario: aparecen con el ratón encima o con
       el foco del teclado, y dan la vuelta como las teclas de flecha. */
    stage.querySelectorAll<HTMLButtonElement>('[data-stage-step]').forEach((btn) => {
      btn.hidden = false;
      btn.addEventListener('click', () => select(current + Number(btn.dataset.stageStep)));
    });

    /* Patrón de pestañas de la APG con activación automática: flechas, Inicio
       y Fin mueven el foco y seleccionan a la vez. */
    tablist.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = {
        ArrowRight: current + 1,
        ArrowLeft: current - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      if (!(e.key in keys)) return;
      e.preventDefault();
      select(keys[e.key], true);
    });

    /* Deslizar el escenario con el dedo: horizontal cambia de servicio, el
       vertical lo sigue haciendo el navegador (touch-action: pan-y). */
    let sx = 0, sy = 0, tracking = false;
    viewport.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      sx = e.clientX;
      sy = e.clientY;
    });
    viewport.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy) * 1.4) return;
      select(current + (dx < 0 ? 1 : -1));
    });
    viewport.addEventListener('pointercancel', () => { tracking = false; });

    // Primera colocación sin transición: si no, la barra entra deslizándose.
    indicator.style.transition = 'none';
    placeIndicator();
    syncScrollEnd();
    requestAnimationFrame(() => requestAnimationFrame(() => { indicator.style.transition = ''; }));
    new ResizeObserver(() => { placeIndicator(); syncScrollEnd(); }).observe(tablist);
    document.fonts?.ready.then(placeIndicator);

    if ('IntersectionObserver' in window) {
      /* Fuera de pantalla se suelta el alto mínimo que dejan los cambios. */
      new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) viewport.style.minBlockSize = '';
      }).observe(viewport);
    }

    /* Primera vez que el escenario entra en pantalla: la lista se marca una a
       una y el precio cuenta desde cero. Con movimiento reducido, nada. */
    if (reduce.matches || !('IntersectionObserver' in window)) {
      stage.classList.add('is-played');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((en) => en.isIntersecting)) return;
          io.disconnect();
          stage.classList.add('is-played');
          replayChecklist(panels[current]);
          tweenPrice(panels[current], 0, sep);
        },
        { rootMargin: '0px 0px -15% 0px' },
      );
      io.observe(stage);
    }

    /* Pieza 3D (las líneas con entrada en VISUALS): three.js se pide con import() cuando el
       escenario se acerca a la pantalla, así que no entra en el JS inicial.
       Si no hay WebGL o falla la carga, se queda el SVG estático. Se libera
       en pagehide y se vuelve a montar si la página vuelve de la caché. */
    const visual = stage.dataset.visual;
    const loader = visual ? VISUALS[visual as StageKind] : undefined;
    if (loader && 'IntersectionObserver' in window) {
      let dispose: (() => void) | null = null;
      let wanted = false;
      const mount = async () => {
        try {
          const mod = await loader();
          if (wanted && !dispose) dispose = mod.mount(stage);
        } catch {
          /* sin pieza 3D: se queda la ilustración SVG */
        }
      };
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((en) => en.isIntersecting)) return;
          near.disconnect();
          wanted = true;
          mount();
        },
        { rootMargin: '400px 0px' },
      );
      near.observe(stage);
      window.addEventListener('pagehide', () => {
        dispose?.();
        dispose = null;
      });
      window.addEventListener('pageshow', (e) => {
        if (e.persisted && wanted && !dispose) mount();
      });
    }
  });
</script>
