---
/**
 * Enlace corto geomachine.es/optimus (el que se imprime en el QR).
 * El sitio es estático: no hay redirección por idioma en el servidor, así que
 * la página elige idioma con JS (navigator.languages), con un <meta refresh>
 * a la versión en español como respaldo sin JS y enlaces visibles a las cuatro.
 */
const site = 'https://geomachine.es';
const targets = {
  es: { path: '/es/servicios/optimus/', label: 'Español' },
  ru: { path: '/ru/uslugi/optimus/', label: 'Русский' },
  en: { path: '/en/services/optimus/', label: 'English' },
  ka: { path: '/ka/momsakhurebebi/optimus/', label: 'ქართული' },
};
const fallback = targets.es.path;
const paths = Object.fromEntries(Object.entries(targets).map(([k, v]) => [k, v.path]));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Optimus — GeoMachine</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={site + fallback} />
    <meta http-equiv="refresh" content={`3;url=${fallback}`} />
    <link rel="icon" type="image/svg+xml" href="/optimus/simbolo.svg" />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0f1115; color: #f2f2f2; font-family: system-ui, sans-serif; text-align: center; padding: 16px; }
      img { width: min(80vw, 18rem); height: auto; }
      ul { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      a { color: #f2f2f2; padding: 10px 18px; border: 1px solid #555; border-radius: 8px; text-decoration: none; }
      a:hover { border-color: #fff; }
    </style>
  </head>
  <body>
    <main>
      <img src="/optimus/logotipo-sobre-oscuro.svg" alt="Optimus" width="308" height="90" />
      <ul>
        {Object.entries(targets).map(([code, { path, label }]) => (
          <li><a href={path} hreflang={code}>{label}</a></li>
        ))}
      </ul>
    </main>
    <script is:inline define:vars={{ paths, fallback }}>
      var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
      var dest = fallback;
      for (var i = 0; i < langs.length; i++) {
        var code = String(langs[i]).toLowerCase().split('-')[0];
        if (paths[code]) { dest = paths[code]; break; }
      }
      location.replace(dest + location.search + location.hash);
    </script>
  </body>
</html>
