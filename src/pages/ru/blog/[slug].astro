---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleSchema from '../../../components/ArticleSchema.astro';
import BlogPostView from '../../../components/BlogPostView.astro';
import { blogPath } from '../../../i18n/ui';
import { buildHreflang, isPublished, relatedArticles, blogCoverPath } from '../../../lib/blog';

export async function getStaticPaths() {
  const [ruEntries, esEntries] = await Promise.all([
    getCollection('blog', (e) => e.id.startsWith('ru/') && isPublished(e)),
    // La pareja de hreflang solo puede apuntar a un post es que exista de
    // verdad en el build actual — un borrador en es no genera página en
    // producción, así que no puede ser destino de un enlace.
    getCollection('blog', (e) => e.id.startsWith('es/') && isPublished(e)),
  ]);
  return ruEntries.map((entry) => {
    const slug = entry.slug.replace(/^ru\//, '');
    const counterpart = entry.data.translationSlug
      ? esEntries.find((e) => e.slug === `es/${entry.data.translationSlug}`)
      : undefined;
    const related = relatedArticles(ruEntries, entry);
    return { params: { slug }, props: { entry, counterpart, related } };
  });
}

const { entry, counterpart, related } = Astro.props;
const { Content } = await entry.render();
const site = Astro.site?.origin ?? 'https://geomachine.es';
const slug = entry.slug.replace(/^ru\//, '');
const pageUrl = `${site}${blogPath.ru}${slug}/`;
const coverUrl = `${site}${blogCoverPath('ru', slug)}`;
const alternates = buildHreflang({ site, lang: 'ru', slug, counterpart });
---

<Base
  lang="ru"
  noindex={entry.data.draft}
  pageUrl={pageUrl}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  ogImage={coverUrl}
  hreflangAlternates={alternates}
  schema="none"
>
  <ArticleSchema
    slot="head"
    lang="ru"
    title={entry.data.title}
    description={entry.data.description}
    pubDate={entry.data.pubDate}
    updatedDate={entry.data.updatedDate}
    pageUrl={pageUrl}
    image={coverUrl}
  />
  <BlogPostView lang="ru" entry={entry} related={related}>
    <Content />
  </BlogPostView>
</Base>
