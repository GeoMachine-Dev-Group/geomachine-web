---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleSchema from '../../../components/ArticleSchema.astro';
import BlogNav from '../../../components/BlogNav.astro';
import { ui, servicesPath, blogPath } from '../../../i18n/ui';
import { buildHreflang, catalogAnchor, isPublished, relatedArticles } from '../../../lib/blog';

export async function getStaticPaths() {
  const [ruEntries, esEntries] = await Promise.all([
    getCollection('blog', (e) => e.id.startsWith('ru/') && isPublished(e)),
    // La pareja de hreflang solo puede apuntar a un post es que exista de
    // verdad en el build actual — un borrador en es no genera página en
    // producción, así que no puede ser destino de un enlace.
    getCollection('blog', (e) => e.id.startsWith('es/') && isPublished(e)),
  ]);
  return ruEntries.map((entry) => {
    const slug = entry.slug.replace(/^ru\//, '');
    const counterpart = entry.data.translationSlug
      ? esEntries.find((e) => e.slug === `es/${entry.data.translationSlug}`)
      : undefined;
    const related = relatedArticles(ruEntries, entry);
    return { params: { slug }, props: { entry, counterpart, related } };
  });
}

const { entry, counterpart, related } = Astro.props;
const { Content } = await entry.render();
const t = ui.ru;
const site = Astro.site?.origin ?? 'https://geomachine.es';
const slug = entry.slug.replace(/^ru\//, '');
const pageUrl = `${site}${blogPath.ru}${slug}/`;
const alternates = buildHreflang({ site, lang: 'ru', slug, counterpart });
---

<Base
  lang="ru"
  noindex={entry.data.draft}
  pageUrl={pageUrl}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  hreflangAlternates={alternates}
  schema="none"
>
  <ArticleSchema
    slot="head"
    lang="ru"
    title={entry.data.title}
    description={entry.data.description}
    pubDate={entry.data.pubDate}
    updatedDate={entry.data.updatedDate}
    pageUrl={pageUrl}
  />
  <BlogNav lang="ru" currentTitle={entry.data.title} />
  <article class="shell">
    <p data-pillar>{entry.data.pillar}</p>
    <h1>{entry.data.title}</h1>
    <time datetime={entry.data.pubDate.toISOString()}>
      {entry.data.pubDate.toLocaleDateString('ru-RU')}
    </time>
    <Content />
    {entry.data.relatedService && (
      <p>
        <a href={`${servicesPath.ru}#${catalogAnchor(entry.data.relatedService)}`}>
          {t.blogRelated}: {entry.data.relatedService}
        </a>
      </p>
    )}
    {related.length > 0 && (
      <nav class="blog-related" aria-label={t.blogRelatedArticles}>
        <p class="blog-related__title">{t.blogRelatedArticles}</p>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`${blogPath.ru}${r.slug.replace(/^ru\//, '')}/`}>{r.data.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</Base>
