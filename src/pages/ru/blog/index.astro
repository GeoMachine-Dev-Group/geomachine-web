---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BlogNav from '../../../components/BlogNav.astro';
import { ui, blogPath } from '../../../i18n/ui';
import { isPublished, blogIndexHreflang, excerpt, readingTime } from '../../../lib/blog';

const posts = (await getCollection('blog', (e) => e.id.startsWith('ru/') && isPublished(e))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const t = ui.ru;
const site = Astro.site?.origin ?? 'https://geomachine.es';
---

<Base
  lang="ru"
  pageUrl={`${site}${blogPath.ru}`}
  title={`${t.blogTitle} — ${t.company}`}
  description={t.blogMetaDescription}
  hreflangAlternates={blogIndexHreflang(site)}
  schema="none"
>
  <BlogNav lang="ru" />
  <section class="shell">
    <h1>{t.blogTitle}</h1>
    {posts.length === 0 && <p>{t.blogEmpty}</p>}
    <div class="blog-cards">
      {posts.map((post) => {
        const slug = post.slug.replace(/^ru\//, '');
        return (
          <article class="blog-card" id={post.data.pillar.toLowerCase()} data-pillar={post.data.pillar}>
            <a class="blog-card__link" href={`${blogPath.ru}${slug}/`}>
              <span class="blog-card__meta">
                {post.data.pillar} · {readingTime(post.body)} {t.readingTimeSuffix}
              </span>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__excerpt">{excerpt(post.body)}</p>
            </a>
          </article>
        );
      })}
    </div>
  </section>
</Base>
