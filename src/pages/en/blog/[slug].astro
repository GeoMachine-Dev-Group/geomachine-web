---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ArticleSchema from '../../../components/ArticleSchema.astro';
import BlogPostView from '../../../components/BlogPostView.astro';
import { blogPath } from '../../../i18n/ui';
import { buildHreflang, isPublished, relatedArticles, blogCoverPath } from '../../../lib/blog';

export async function getStaticPaths() {
  // Los artículos en inglés son piezas propias, no traducciones de los de es o
  // ru: escritos para quien busca en inglés y para los modelos de IA, que leen
  // y citan sobre todo en este idioma. Por eso casi ninguno tiene pareja, y
  // buildHreflang deduce el idioma de la que la tenga a partir de su slug.
  const [enEntries, otherEntries] = await Promise.all([
    getCollection('blog', (e) => e.id.startsWith('en/') && isPublished(e)),
    getCollection('blog', (e) => !e.id.startsWith('en/') && isPublished(e)),
  ]);
  return enEntries.map((entry) => {
    const slug = entry.slug.replace(/^en\//, '');
    const counterpart = entry.data.translationSlug
      ? otherEntries.find((e) => e.slug.split('/')[1] === entry.data.translationSlug)
      : undefined;
    const related = relatedArticles(enEntries, entry);
    return { params: { slug }, props: { entry, counterpart, related } };
  });
}

const { entry, counterpart, related } = Astro.props;
const { Content } = await entry.render();
const site = Astro.site?.origin ?? 'https://geomachine.es';
const slug = entry.slug.replace(/^en\//, '');
const pageUrl = `${site}${blogPath.en}${slug}/`;
const coverUrl = `${site}${blogCoverPath('en', slug)}`;
const alternates = buildHreflang({ site, lang: 'en', slug, counterpart });
---

<Base
  lang="en"
  noindex={entry.data.draft}
  pageUrl={pageUrl}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
  ogImage={coverUrl}
  hreflangAlternates={alternates}
  schema="none"
>
  <ArticleSchema
    slot="head"
    lang="en"
    title={entry.data.title}
    description={entry.data.description}
    pubDate={entry.data.pubDate}
    updatedDate={entry.data.updatedDate}
    pageUrl={pageUrl}
    image={coverUrl}
  />
  <BlogPostView lang="en" entry={entry} related={related}>
    <Content />
  </BlogPostView>
</Base>
