---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BlogIndexView from '../../../components/BlogIndexView.astro';
import { ui, blogPath } from '../../../i18n/ui';
import { isPublished, blogIndexHreflang } from '../../../lib/blog';

const posts = (await getCollection('blog', (e) => e.id.startsWith('es/') && isPublished(e))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const t = ui.es;
const site = Astro.site?.origin ?? 'https://geomachine.es';
---

<Base
  lang="es"
  pageUrl={`${site}${blogPath.es}`}
  title={`${t.blogTitle} — ${t.company}`}
  description={t.blogMetaDescription}
  hreflangAlternates={blogIndexHreflang(site)}
  schema="none"
>
  <BlogIndexView lang="es" posts={posts} />
</Base>
