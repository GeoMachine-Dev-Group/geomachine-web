---
import '../styles/global.css';
import { ui, servicesPath, blogPath, aboutPath, aboutLangFor, languages, hasBlog, type Lang } from '../i18n/ui';
import { DEFAULT_TIER, LANG_CURRENCY } from '../data/catalog';
import { buildOrganization, buildWebSite } from '../data/organization';
import { legalPath, legalLangFor } from '../data/legal';
import Schema from '../components/Schema.astro';
import FloatingChat from '../components/FloatingChat.astro';
import Logo from '../components/Logo.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface HreflangAlt {
  hreflang: string;
  href: string;
}

interface Props {
  lang: Lang;
  /** Excluye la página de los índices (404, borradores…). */
  noindex?: boolean;
  /** Overrides opcionales — sin ellos, el layout se comporta exactamente
      como antes (catálogo). El blog los usa para no heredar canonical,
      hreflang, título, descripción ni og:image del catálogo. */
  pageUrl?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  /** Iconos propios de la página (una app con su marca). Sin ellos, los de GeoMachine. */
  icons?: { svg: string; png32: string; appleTouch: string };
  ogType?: 'website' | 'article';
  hreflangAlternates?: HreflangAlt[];
  /** 'catalog' (por defecto) renderiza el JSON-LD del catálogo. 'none' lo
      omite para que la página inyecte el suyo propio vía el slot "head"
      (el blog usa BlogPosting, no OfferCatalog). */
  schema?: 'catalog' | 'none';
  /** Analítica de Vercel. Activada por defecto en todas las páginas. */
  analytics?: boolean;
}
const {
  lang,
  noindex = false,
  schema = 'catalog',
  ogType = 'website',
  analytics = true,
} = Astro.props;
const t = ui[lang];
const site = Astro.site?.origin ?? 'https://geomachine.es';
const pageUrl = Astro.props.pageUrl ?? site + servicesPath[lang];
const title = Astro.props.title ?? t.metaTitle;
const description = Astro.props.description ?? t.metaDescription;
const ogLocale: Record<Lang, string> = { es: 'es_ES', ru: 'ru_RU', en: 'en_US', ka: 'ka_GE' };
const icons = Astro.props.icons ?? {
  svg: '/favicon.svg',
  png32: '/favicon.png',
  appleTouch: '/apple-touch-icon.png',
};
const ogImage = Astro.props.ogImage ?? `${site}/og/og-${lang}.png`;
const hreflangAlternates: HreflangAlt[] =
  Astro.props.hreflangAlternates ??
  [
    ...Object.entries(servicesPath).map(([code, path]) => ({ hreflang: code, href: site + path })),
    { hreflang: 'x-default', href: site + servicesPath.es },
  ];
/** Fuente del H1 (elemento LCP) que se precarga en cada idioma.
    Al añadir un idioma, apunta aquí a la cara que realmente use su alfabeto:
    el georgiano usa Noto Sans Georgian, no Outfit (que no tiene esos glifos). */
const speculationWhere = [
  { href_matches: '/*' },
  { not: { href_matches: '/api/*' } },
  { not: { href_matches: '/downloads/*' } },
  { not: { selector_matches: '[target=_blank], [download], [rel~=nofollow]' } },
];
const preloadFont: Record<Lang, string> = {
  es: '/fonts/outfit-700-latin.woff2',
  ru: '/fonts/unbounded-700-cyrillic.woff2',
  en: '/fonts/outfit-700-latin.woff2',
  ka: '/fonts/noto-sans-georgian-700-georgian.woff2',
};

---

<!doctype html>
<html lang={t.htmlLang} data-tier={DEFAULT_TIER} data-currency={LANG_CURRENCY[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Barra del navegador en el móvil con el verde de la web (--paper). -->
    <meta name="theme-color" content="#10160f" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={icons.svg} />
    <link rel="icon" type="image/png" sizes="32x32" href={icons.png32} />
    <link rel="apple-touch-icon" href={icons.appleTouch} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Yandex Webmaster & Google Verification Tags -->
    <meta name="yandex-verification" content="ea3ef14ef294e971" />
    <!-- Bing Webmaster Tools (alta del 2026-11-10; ChatGPT busca con Bing) -->
    <meta name="msvalidate.01" content="A201AB8C2858113062FD0257FF515922" />

    <link rel="canonical" href={pageUrl} />
    {
      hreflangAlternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.company} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="manifest" href="/site.webmanifest" />

    <!-- Datos estructurados JSON-LD de la organización — única fuente,
         ver src/data/organization.ts. El resto de nodos (WebPage, BlogPosting,
         SoftwareApplication...) solo referencian este @id, nunca lo redeclaran. -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [buildOrganization(site, lang), buildWebSite(site)],
    })} />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={preloadFont[lang]}
      crossorigin
    />

    <!-- Transiciones entre páginas (global.css, @view-transition): no pintar la
         página nueva hasta tener el main, para no animar hacia una página en
         blanco (guía consistent-cross-document-transitions). Solo Chrome/Edge;
         el resto lo ignora. -->
    <link rel="expect" href="#main" blocking="render" />

    <!-- Precarga de la página siguiente (guía improve-next-page-load-performance).
         Prefetch al pasar el ratón ~200 ms por un enlace interno; prerender
         completo solo al empezar el clic (conservative), para no ejecutar la
         analítica de páginas que no se llegan a abrir. Fuera /api, descargas y
         enlaces que abren pestaña. Solo Chrome/Edge; el resto lo ignora. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [{ where: { and: speculationWhere }, eagerness: 'moderate' }],
      prerender: [{ where: { and: speculationWhere }, eagerness: 'conservative' }],
    })} />

    <script is:inline>
      // Modo tarjeta: Inclinación 3D ('tilt')
      try {
        document.documentElement.dataset.cardstyle = 'tilt';
      } catch (e) {}
    </script>

    {schema === 'catalog' && <Schema lang={lang} />}
    <slot name="head" />
  </head>

  <body>
    <header class="plate">
      <div class="shell plate__row">
        <a href={servicesPath[lang]} class="plate__logo-link" aria-label="GeoMachine">
          <Logo class="plate__logo" width="28" height="28" />
          <span class="plate__mark">GEO<span>·</span>MACHINE</span>
        </a>
        <span>{t.plate}</span>
        <nav class="plate__links">
          <a href={aboutPath[aboutLangFor(lang)]} hreflang={aboutLangFor(lang)}>{t.aboutNav}</a>
          {
            hasBlog(lang) && (
              <a href={blogPath[lang]} class="plate__blog-link">
                {t.blogTitle}
              </a>
            )
          }
          {
            (Object.keys(languages) as Lang[])
              .filter((l) => l !== lang)
              .map((l) => (
                <a href={servicesPath[l]} hreflang={l} lang={l}>
                  {languages[l]}
                </a>
              ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot__row">
        <span>{t.footer} · <a href={aboutPath[aboutLangFor(lang)]} hreflang={aboutLangFor(lang)}>Romeo Mikava</a></span>
        {/* En ka los textos legales van en inglés (no hay versión georgiana). */}
        <nav class="foot__legal" aria-label={t.legalNav}>
          <a href={legalPath('notice', lang)} hreflang={legalLangFor(lang)}>{t.legalNotice}</a>
          <a href={legalPath('privacy', lang)} hreflang={legalLangFor(lang)}>{t.legalPrivacy}</a>
          <a href={legalPath('cookies', lang)} hreflang={legalLangFor(lang)}>{t.legalCookies}</a>
        </nav>
      </div>
    </footer>

    <FloatingChat lang={lang} />

    <script>
      const root = document.documentElement;

      /** Repinta cada precio con la combinación tarifa+moneda activa. */
      function paint() {
        const cur = root.dataset.currency ?? '';
        document.querySelectorAll<HTMLElement>('[data-price]').forEach((cell) => {
          const from = cell.querySelector<HTMLElement>('.card__price-from');
          if (from) from.textContent = cell.dataset['from' + cur] ?? '';

          const was = cell.querySelector<HTMLElement>('.card__price-was');
          if (was) {
            const wasText = cell.dataset['was' + cur] ?? '';
            was.textContent = wasText;
            was.hidden = !wasText;
          }

          const detail = cell.querySelector<HTMLElement>('.card__price-detail');
          if (detail) {
            const detailText = cell.dataset['detail' + cur] ?? '';
            detail.textContent = detailText;
            detail.hidden = !detailText;
          }
        });
      }

      /** Cambia la moneda con el desenfoque de 160 ms que ya define el CSS. La
          tarifa ya no se elige: la deciden las plazas libres (catalog.ts). */
      function setVal(key: 'currency', val: string) {
        if (root.dataset[key] === val) return;
        root.dataset[key] = val;
        document.body.classList.add('is-swapping');
        window.setTimeout(() => {
          paint();
          document.body.classList.remove('is-swapping');
        }, 160);

        document.querySelectorAll<HTMLElement>(`[data-set="${key}"]`).forEach((btn) => {
          btn.setAttribute('aria-pressed', String(btn.dataset.value === val));
        });

        try {
          localStorage.setItem('gm-' + key, val);
        } catch (e) {}
      }

      document.querySelectorAll<HTMLElement>('[data-set]').forEach((btn) => {
        btn.addEventListener('click', () =>
          setVal(btn.dataset.set as 'currency', btn.dataset.value ?? '')
        );
      });

      try {
        // Limpia la tarifa que guardaba el selector retirado: un "standard"
        // guardado ya no significa nada y no debe quedarse en el navegador.
        localStorage.removeItem('gm-tier');
        const savedCurrency = localStorage.getItem('gm-currency');
        if (savedCurrency) setVal('currency', savedCurrency);
      } catch (e) {}

      paint();

      /* Modal de contacto profesional: <dialog> nativo (Catalog.astro). */
      const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
      const modalServiceSelect = document.getElementById('modal-service-select') as HTMLSelectElement | null;

      function openModal(serviceName?: string) {
        if (!modal || modal.open) return;
        if (serviceName && modalServiceSelect) {
          const matchingOpt = Array.from(modalServiceSelect.options).find(
            (opt) => opt.value.toLowerCase().includes(serviceName.toLowerCase()) || serviceName.toLowerCase().includes(opt.value.toLowerCase())
          );
          if (matchingOpt) modalServiceSelect.value = matchingOpt.value;
        }
        // showModal(): foco dentro, resto de la página inerte y Esc para cerrar.
        modal.showModal();
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const trigger = target?.closest<HTMLElement>('a[href="#contacto"], [data-open-modal], .fab');
        if (trigger && modal) {
          e.preventDefault();
          const card = trigger.closest<HTMLElement>('.card');
          const serviceName = card?.querySelector('.card__name')?.textContent?.trim();
          openModal(serviceName);
        }
        if (target?.closest('[data-close-modal]')) modal?.close();
      });

      /* Respaldo de closedby="any" para Safari: un clic cuyo destino es el
         propio <dialog> y cae fuera de su caja es un clic en el fondo. */
      if (modal && !('closedBy' in HTMLDialogElement.prototype)) {
        modal.addEventListener('click', (e) => {
          if (e.target !== modal) return;
          const r = modal.getBoundingClientRect();
          const inside = r.top <= e.clientY && e.clientY <= r.bottom && r.left <= e.clientX && e.clientX <= r.right;
          if (!inside) modal.close();
        });
      }

      /* Inclinación 3D siguiendo al cursor: solo en modo tilt, con movimiento
         permitido y en dispositivos con puntero fino de verdad — sin esto el
         listener se registraba en toda visita táctil aunque el tilt nunca
         fuera a activarse ahí. Delegado en document para no atar un oyente
         por tarjeta. */
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        /* Rendimiento: medir la tarjeta una vez al entrar (no en cada
           movimiento, que obligaba a recalcular el layout tras cada escritura)
           y escribir como mucho una vez por fotograma. La medida se descarta
           al hacer scroll o cambiar de tarjeta. */
        let tiltCard: HTMLElement | null = null;
        let tiltRect: DOMRect | null = null;
        let tiltX = 0, tiltY = 0, tiltFrame = 0;
        const applyTilt = () => {
          tiltFrame = 0;
          if (!tiltCard) return;
          tiltRect ??= tiltCard.getBoundingClientRect();
          const px = (tiltX - tiltRect.left) / tiltRect.width;
          const py = (tiltY - tiltRect.top) / tiltRect.height;
          tiltCard.style.setProperty('--rx', (px - 0.5) * 14 + 'deg');
          tiltCard.style.setProperty('--ry', -(py - 0.5) * 14 + 'deg');
          tiltCard.style.setProperty('--mx', px * 100 + '%');
          tiltCard.style.setProperty('--my', py * 100 + '%');
        };
        window.addEventListener('scroll', () => { tiltRect = null; }, { passive: true });
        document.addEventListener('mousemove', (e) => {
          if (root.dataset.cardstyle !== 'tilt') return;
          const card = (e.target as Element | null)?.closest<HTMLElement>('.card');
          if (!card) return;
          if (card !== tiltCard) { tiltCard = card; tiltRect = null; }
          tiltX = e.clientX; tiltY = e.clientY;
          tiltFrame ||= requestAnimationFrame(applyTilt);
        });
        document.addEventListener('mouseout', (e) => {
          const card = (e.target as Element | null)?.closest<HTMLElement>('.card');
          if (card && !card.contains(e.relatedTarget as Node | null)) {
            if (card === tiltCard) { tiltCard = null; tiltRect = null; } // que un fotograma pendiente no la vuelva a inclinar
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--ry', '0deg');
          }
        });
        document.addEventListener('click', (e) => {
          const targetCard = (e.target as Element | null)?.closest<HTMLElement>('.card');
          document.querySelectorAll('.card.is-active').forEach((c) => {
            if (c !== targetCard) c.classList.remove('is-active');
          });
          if (targetCard) targetCard.classList.toggle('is-active');
        });
      }

      // Aparición progresiva de las filas: solo donde el CSS no puede hacerlo
      // ligado al scroll (global.css, .reveal).
      const nativeReveal = CSS.supports('(animation-timeline: view()) and (animation-range: entry)');
      const io = nativeReveal ? null : new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io?.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px' }
      );
      if (io) document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    </script>

    {/* Analítica de Vercel. Va al final del body y no en el head: el
        componente emite un elemento <vercel-analytics>, que dentro de
        <head> sería markup inválido. Sin cookies, como el Plausible al
        que sustituye. */}
    {analytics && <Analytics />}
    {analytics && <SpeedInsights />}
  </body>
</html>
