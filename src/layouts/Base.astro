---
import '../styles/global.css';
import { ui, servicesPath, blogPath, languages, type Lang } from '../i18n/ui';
import { DEFAULT_TIER, DEFAULT_CURRENCY } from '../data/catalog';
import Schema from '../components/Schema.astro';
import FloatingChat from '../components/FloatingChat.astro';
import Logo from '../components/Logo.astro';

interface HreflangAlt {
  hreflang: string;
  href: string;
}

interface Props {
  lang: Lang;
  /** Excluye la página de los índices (404, borradores…). */
  noindex?: boolean;
  /** Overrides opcionales — sin ellos, el layout se comporta exactamente
      como antes (catálogo). El blog los usa para no heredar canonical,
      hreflang, título, descripción ni og:image del catálogo. */
  pageUrl?: string;
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  hreflangAlternates?: HreflangAlt[];
  /** 'catalog' (por defecto) renderiza el JSON-LD del catálogo. 'none' lo
      omite para que la página inyecte el suyo propio vía el slot "head"
      (el blog usa BlogPosting, no OfferCatalog). */
  schema?: 'catalog' | 'none';
  /** Analítica Plausible. Activada por defecto en todas las páginas. */
  analytics?: boolean;
}
const {
  lang,
  noindex = false,
  schema = 'catalog',
  ogType = 'website',
  analytics = true,
} = Astro.props;
const t = ui[lang];
const site = Astro.site?.origin ?? 'https://geomachine.es';
const pageUrl = Astro.props.pageUrl ?? site + servicesPath[lang];
const title = Astro.props.title ?? t.metaTitle;
const description = Astro.props.description ?? t.metaDescription;
const ogLocale: Record<Lang, string> = { es: 'es_ES', ru: 'ru_RU', en: 'en_US', ka: 'ka_GE' };
const ogImage = Astro.props.ogImage ?? `${site}/og/og-${lang}.png`;
const hreflangAlternates: HreflangAlt[] =
  Astro.props.hreflangAlternates ??
  [
    ...Object.entries(servicesPath).map(([code, path]) => ({ hreflang: code, href: site + path })),
    { hreflang: 'x-default', href: site + servicesPath.es },
  ];
/** Fuente del H1 (elemento LCP) que se precarga en cada idioma.
    Al añadir un idioma, apunta aquí a la cara que realmente use su alfabeto:
    el georgiano usa Noto Sans Georgian, no Outfit (que no tiene esos glifos). */
const preloadFont: Record<Lang, string> = {
  es: '/fonts/outfit-700-latin.woff2',
  ru: '/fonts/unbounded-700-cyrillic.woff2',
  en: '/fonts/outfit-700-latin.woff2',
  ka: '/fonts/noto-sans-georgian-700-georgian.woff2',
};

---

<!doctype html>
<html lang={t.htmlLang} data-tier={DEFAULT_TIER} data-currency={DEFAULT_CURRENCY}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {
      analytics && (
        <Fragment>
          <!-- Privacy-friendly analytics by Plausible -->
          <script async is:inline src="https://plausible.io/js/pa-NIwQqrNqgLgRBGMA-ukZ8.js" />
          <script is:inline>
            window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments) };
            plausible.init = plausible.init || function (i) { plausible.o = i || {} };
            plausible.init();
          </script>
        </Fragment>
      )
    }

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Yandex Webmaster & Google Verification Tags -->
    <meta name="yandex-verification" content="ea3ef14ef294e971" />

    <link rel="canonical" href={pageUrl} />
    {
      hreflangAlternates.map(({ hreflang, href }) => (
        <link rel="alternate" hreflang={hreflang} href={href} />
      ))
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.company} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="manifest" href="/site.webmanifest" />

    <!-- Datos estructurados JSON-LD para Google Rich Snippets & Indexación por IAs -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "ProfessionalService"],
      "name": t.company,
      "url": site,
      "logo": `${site}/favicon.png`,
      "description": t.metaDescription,
      "sameAs": [
        "https://t.me/geomachine"
      ],
      "knowsAbout": [
        "Web Development",
        "Mobile App Development",
        "Local Private AI",
        "Search Engine Optimization",
        "Cloud Infrastructure",
        "Astro",
        "React",
        "Flutter"
      ]
    })} />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={preloadFont[lang]}
      crossorigin
    />

    <script is:inline>
      // Paleta por defecto: verde botella y bronce ('botella')
      // Modo tarjeta: Inclinación 3D ('tilt')
      // Sello de lanzamiento: Rotación automática cada 30 min ('gold_liquid', 'radar', 'cli')
      try {
        var p = localStorage.getItem('gm-palette') || 'botella';
        document.documentElement.dataset.palette = p;
        document.documentElement.dataset.cardstyle = 'tilt';

        var stampList = ['gold_liquid', 'radar', 'cli'];
        var idx = Math.floor(Date.now() / (30 * 60 * 1000)) % stampList.length;
        document.documentElement.dataset.stampstyle = stampList[idx];
      } catch (e) {}
    </script>

    {schema === 'catalog' && <Schema lang={lang} />}
    <slot name="head" />
  </head>

  <body>
    <header class="plate">
      <div class="shell plate__row">
        <a href={servicesPath[lang]} class="plate__logo-link" aria-label="GeoMachine">
          <Logo class="plate__logo" width="46" height="30" />
          <span class="plate__mark">GEO<span>·</span>MACHINE</span>
        </a>
        <span>{t.plate} — {t.rev}</span>
        <nav class="plate__links">
          {
            (lang === 'es' || lang === 'ru') && (
              <a href={blogPath[lang]} class="plate__blog-link">
                {t.blogTitle}
              </a>
            )
          }
          {
            (Object.keys(languages) as Lang[])
              .filter((l) => l !== lang)
              .map((l) => (
                <a href={servicesPath[l]} hreflang={l} lang={l}>
                  {languages[l]}
                </a>
              ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="shell foot__row">
        <span>{t.footer}</span>
        <span>{t.rev}</span>
      </div>
    </footer>

    <FloatingChat lang={lang} />

    <a href="#contacto" class="fab" data-fab hidden>
      {t.ctaButton}
    </a>

    <script>
      const root = document.documentElement;

      /** Repinta cada precio con la combinación tarifa+moneda activa. */
      function paint() {
        const combo = (root.dataset.tier ?? '') + (root.dataset.currency ?? '');
        document.querySelectorAll<HTMLElement>('[data-price]').forEach((cell) => {
          const main = cell.querySelector<HTMLElement>('.price-value');
          if (main) main.textContent = cell.dataset[combo] ?? '';

          const recWrap = cell.querySelector<HTMLElement>('.card__recurring');
          if (!recWrap) return;
          const recText = cell.dataset['r' + combo];
          recWrap.hidden = !recText;
          const rec = recWrap.querySelector<HTMLElement>('.price-value');
          if (rec && recText) rec.textContent = recText;
        });
      }

      /** Cambia tarifa o moneda con el desenfoque de 160 ms que ya define el CSS. */
      function setVal(key: 'tier' | 'currency', val: string) {
        if (root.dataset[key] === val) return;
        root.dataset[key] = val;
        document.body.classList.add('is-swapping');
        window.setTimeout(() => {
          paint();
          document.body.classList.remove('is-swapping');
        }, 160);

        document.querySelectorAll<HTMLElement>(`[data-set="${key}"]`).forEach((btn) => {
          btn.setAttribute('aria-pressed', String(btn.dataset.value === val));
        });

        // El sello y la nota del panel solo dependen de la tarifa.
        if (key === 'tier') {
          const stamp = document.querySelector<HTMLElement>('.stamp');
          if (stamp) stamp.hidden = val !== 'launch';
          document.querySelectorAll<HTMLElement>('[data-note]').forEach((n) => {
            n.hidden = n.dataset.note !== val;
          });
        }

        try {
          localStorage.setItem('gm-' + key, val);
        } catch (e) {}
      }

      document.querySelectorAll<HTMLElement>('[data-set]').forEach((btn) => {
        btn.addEventListener('click', () =>
          setVal(btn.dataset.set as 'tier' | 'currency', btn.dataset.value ?? '')
        );
      });

      try {
        const savedTier = localStorage.getItem('gm-tier');
        const savedCurrency = localStorage.getItem('gm-currency');
        if (savedTier) setVal('tier', savedTier);
        if (savedCurrency) setVal('currency', savedCurrency);
      } catch (e) {}

      paint();

      /* Botón de cambio directo de paleta de colores */
      const paletteBtn = document.getElementById('palette-toggle-btn');
      const activePalettes = ['botella', 'agencia', 'esmeralda', 'premium', 'cobalto'];
      if (paletteBtn) {
        paletteBtn.addEventListener('click', () => {
          const current = root.dataset.palette || 'botella';
          const nextIdx = (activePalettes.indexOf(current) + 1) % activePalettes.length;
          const nextPalette = activePalettes[nextIdx];
          root.dataset.palette = nextPalette;
          try {
            localStorage.setItem('gm-palette', nextPalette);
          } catch (e) {}
        });
      }

      /* Rotación continua del sello cada 30 minutos */
      setInterval(() => {
        var stampList = ['gold_liquid', 'radar', 'cli'];
        var idx = Math.floor(Date.now() / (30 * 60 * 1000)) % stampList.length;
        root.dataset.stampstyle = stampList[idx];
      }, 60000);

      /* Modal de contacto profesional */
      const modal = document.getElementById('contact-modal') as HTMLElement | null;
      const modalServiceSelect = document.getElementById('modal-service-select') as HTMLSelectElement | null;

      function openModal(serviceName?: string) {
        if (!modal) return;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        if (serviceName && modalServiceSelect) {
          const matchingOpt = Array.from(modalServiceSelect.options).find(
            (opt) => opt.value.toLowerCase().includes(serviceName.toLowerCase()) || serviceName.toLowerCase().includes(opt.value.toLowerCase())
          );
          if (matchingOpt) modalServiceSelect.value = matchingOpt.value;
        }
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const trigger = target?.closest<HTMLElement>('a[href="#contacto"], [data-open-modal], .fab');
        if (trigger && modal) {
          e.preventDefault();
          const card = trigger.closest<HTMLElement>('.card');
          const serviceName = card?.querySelector('.card__name')?.textContent?.trim();
          openModal(serviceName);
        }
        if (target?.closest('[data-close-modal]') || target === modal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
          closeModal();
        }
      });

      /* Inclinación 3D siguiendo al cursor: solo en modo tilt, con movimiento
         permitido y en dispositivos con puntero fino de verdad — sin esto el
         listener se registraba en toda visita táctil aunque el tilt nunca
         fuera a activarse ahí. Delegado en document para no atar un oyente
         por tarjeta. */
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        document.addEventListener('mousemove', (e) => {
          if (root.dataset.cardstyle !== 'tilt') return;
          const card = (e.target as Element | null)?.closest<HTMLElement>('.card');
          if (!card) return;
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;
          const py = (e.clientY - rect.top) / rect.height;
          card.style.setProperty('--rx', (px - 0.5) * 14 + 'deg');
          card.style.setProperty('--ry', -(py - 0.5) * 14 + 'deg');
          card.style.setProperty('--mx', px * 100 + '%');
          card.style.setProperty('--my', py * 100 + '%');
        });
        document.addEventListener('mouseout', (e) => {
          const card = (e.target as Element | null)?.closest<HTMLElement>('.card');
          if (card && !card.contains(e.relatedTarget as Node | null)) {
            card.style.setProperty('--rx', '0deg');
            card.style.setProperty('--ry', '0deg');
          }
        });
        document.addEventListener('click', (e) => {
          const targetCard = (e.target as Element | null)?.closest<HTMLElement>('.card');
          document.querySelectorAll('.card.is-active').forEach((c) => {
            if (c !== targetCard) c.classList.remove('is-active');
          });
          if (targetCard) targetCard.classList.toggle('is-active');
        });
      }

      // Aparición progresiva de las filas.
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      /* Sticky CTA: aparece al perder de vista la cabecera — vive aquí, no en
         Catalog.astro, porque ahora sale también en el blog. Se oculta de
         nuevo cerca de un CTA de cierre si la página declara uno con
         data-fab-hide-near (el catálogo lo hace en su sección de cierre; el
         blog no tiene uno, así que ahí se queda visible una vez aparece). */
      const headerPlate = document.querySelector('.plate');
      const fabHideTarget = document.querySelector('[data-fab-hide-near]');
      const fab = document.querySelector<HTMLElement>('[data-fab]');
      if (headerPlate && fab) {
        fab.hidden = false;
        let pastHeader = false;
        let nearHideTarget = false;
        const syncFab = () => fab.classList.toggle('is-visible', pastHeader && !nearHideTarget);

        new IntersectionObserver(
          ([entry]) => { pastHeader = !entry.isIntersecting; syncFab(); },
          { rootMargin: '-10% 0px 0px 0px' }
        ).observe(headerPlate);

        if (fabHideTarget) {
          new IntersectionObserver(
            ([entry]) => { nearHideTarget = entry.isIntersecting; syncFab(); },
            { threshold: 0.15 }
          ).observe(fabHideTarget);
        }
      }
    </script>
  </body>
</html>
